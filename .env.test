# Dedicated, disposable database for the e2e suite — isolated from the
# hrms_v2_dev database used for manual local development so test runs
# never touch data you're looking at in Swagger/curl while developing.
DATABASE_URL="postgresql://hrms_v2_user:hrms_v2_pass@localhost:5432/hrms_v2_test?schema=public"
JWT_ACCESS_SECRET=test_access_secret_do_not_use_in_prod
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=test_refresh_secret_do_not_use_in_prod
JWT_REFRESH_EXPIRES_IN_DAYS=7
REFRESH_COOKIE_NAME=refresh_token
REFRESH_COOKIE_PATH=/auth
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
CORS_ORIGIN=http://localhost:5173
BCRYPT_SALT_ROUNDS=4
FACE_API_KEY=test_face_api_key_do_not_use_in_prod
AUTH_THROTTLE_LIMIT=1000
EXPENSIVE_OP_THROTTLE_LIMIT=1000
