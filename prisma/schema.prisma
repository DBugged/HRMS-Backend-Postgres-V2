  // genuinely has none, and that's fine for them specifically. Off by
  // default — only flips an employee into "must have a location to punch"
  // once HR explicitly marks them as office-based. See selfPunch in
  // attendance.service.ts.
  requireWorkLocationForPunch Boolean             @default(false)
  // Whether this employee must take a selfie to check in/out: DEFAULT
  // follows the org's orgPayrollAttendancePrefs.requireSelfieForPunch;
  // REQUIRED / NOT_REQUIRED override it either way (e.g. field staff).
  // See common/selfie-requirement.ts.
  selfieRequirement           SelfieRequirement   @default(DEFAULT)
  // What location the punch needs: DEFAULT follows the org's attendance prefs (locationMode); ENFORCED / RECORD_ONLY /
  // NOT_NEEDED override it. See common/location-requirement.ts.
  locationRequirement         LocationRequirement @default(DEFAULT)

  reportingManagerId            String?
  reportingManager              User?    @relation("ReportingManager", fields: [reportingManagerId], references: [id])
  // Further managers beyond the primary one above (a matrix / dotted-line reporting). They can approve and are told about
  // requests exactly like the primary manager. Plain ids (no FK): they are cleaned up when a manager leaves
  // (common/manager-reassignment.ts) and validated as active people of the organisation when set.
  additionalReportingManagerIds String[] @default([])
  // The last working day once an exit is planned (YYYY-MM-DD), kept in step with the resignation / offboarding case.
  // Trackers, absence marking and headcounts stop counting the person after this day, even though the account stays
  // active until Offboarding is completed. Null = no exit planned.
  exitDate                      String?
  subordinates                  User[]   @relation("ReportingManager")

  managedDepartments Department[] @relation("DepartmentHead")

  // { mutedCategories: NotificationCategory[], emailEnabled: boolean } —
