generator client {
  provider = "prisma-client-js"
}

// Connection URL lives in prisma.config.ts (Prisma 7 moved it out of the
// schema file) — used by the CLI for migrate/generate. The runtime
// PrismaClient is configured separately via a driver adapter, see
// src/prisma/prisma.service.ts.
datasource db {
  provider = "postgresql"
}

// A Postgres enum (not a lookup table) — mirrors the old MySQL backend's
// DB-level ENUM role column. Gives compile-time exhaustiveness in TS and
// makes adding SUPER_ADMIN later a one-line addition + one migration,
// rather than a new join table. A lookup table would only be justified for
// arbitrary per-tenant custom roles, which isn't a requirement here.
enum Role {
  ADMIN
  HR
  MANAGER
  EMPLOYEE
  // Future: SUPER_ADMIN. See RolesGuard for exactly how it plugs in.
}

// Mirrors the old MySQL backend's employmentStatus ENUM on User exactly
// (see employeeController.js ground truth) so the lifecycle vocabulary
// carries over unchanged even though the storage model doesn't.
enum EmploymentStatus {
  ONBOARDING
  PROBATION
  EXTENDED_PROBATION
  CONFIRMED
  NOTICE_PERIOD
  RESIGNED
  RELEASED
  TERMINATED
  ABSCONDED
  ON_HOLD
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum ProbationStatus {
  PENDING
  CONFIRMED
  EXTENDED
}

model Organization {
  id        String   @id @default(uuid())
  name      String
  timezone  String   @default("Asia/Kolkata")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Row-locked counter for employeeId generation (SELECT ... FOR UPDATE in
  // EmployeeIdService) — deliberately simpler than the old system's
  // generalized documentNumbering JSON (which covers many document types);
  // this phase only needs the one counter. See the Phase 2 plan for why a
  // per-document-type config system isn't ported yet.
  employeeIdPrefix  String @default("EMP")
  employeeIdCounter Int    @default(0)

  // Admin toggle for whether WFH is offered as a work-arrangement option on
  // Attendance — the column on Attendance always accepts WFH regardless, so
  // disabling this later doesn't orphan history.
  enableWFH              Boolean @default(true)
  // Org-wide fallback shift config, used by AttendanceService whenever an
  // employee's Department has none set (or there's no department at all).
  // A department's own shift-config fields always win over these. NOT the
  // same thing as orgPayrollAttendancePrefs below (Setup Wizard step 8) —
  // that's a much broader admin-facing preferences blob; this one is the
  // narrow AttendanceService consumer built in the Attendance batch. Kept
  // separate deliberately so extending the wizard's JSON shape can never
  // break the attendance-calculation consumer of this field.
  attendancePayrollPrefs Json    @default("{\"defaultShiftStartTime\":\"09:30\",\"defaultShiftEndTime\":\"18:30\",\"defaultLateInThresholdMinutes\":15,\"defaultEarlyOutThresholdMinutes\":15,\"defaultMinHoursForPresent\":8,\"defaultMinHoursForHalfDay\":4,\"weekendDays\":[0,6]}")

  // --- Setup Wizard / Organization Settings — ported from the old
  // system's Organization model verbatim (field-for-field), which is the
  // single source of truth every other tenant-owned row hangs off of.
  // isInitialized gates app access for non-admin roles until an admin
  // finishes the 9-step wizard (enforced client-side, same as before).
  isInitialized   Boolean   @default(false)
  initializedAt   DateTime?
  initializedById String?
  initializedBy   User?     @relation("OrganizationInitializedBy", fields: [initializedById], references: [id])
  setupStep       Int       @default(1)

  // Step 1 — Company Profile
  companyName String?
  legalName   String?
  tagline     String?
  description String?

  // Step 2 — Registration Details
  gstin                  String?
  pan                    String?
  tan                    String?
  cin                    String?
  registrationNumber     String?
  lin                    String?
  msmeRegistrationNumber String?
  epfoEstablishmentCode  String?
  esicEmployerCode       String?
  ptRegistrationNumber   String?
  labourLicenseNumber    String?

  // Step 3 — Contact Information
  registeredAddress String?
  corporateAddress  String?
  city              String?
  state             String?
  country           String  @default("India")
  pincode           String?
  phone             String?
  mobile            String?
  contactEmail      String?
  website           String?

  // Step 4 — Branding (companyLogoUrl doubles as the Step 1 company logo)
  companyLogoUrl String?
  faviconUrl     String?
  reportLogoUrl  String?
  emailLogoUrl   String?
  primaryColor   String  @default("#5546e0")
  secondaryColor String  @default("#14161d")
  // Original filename/size per uploaded image, keyed by upload field name
  // (logo/favicon/reportLogo/emailLogo/signature/seal) — the URL columns
  // point at a generated relativeKey, so this is the only place the real
  // uploaded filename survives, for display in Organization Settings.
  assetMeta      Json    @default("{}")

  // Step 5 — Authorized Signatories: [{ id, name, designation,
  // signatureUrl, signatureMeta: {name,size}, isPrimary }]. Exactly one
  // entry is expected isPrimary:true; readers needing "the" signatory fall
  // back to the first entry. The seal is a single shared asset, its own
  // column, not per-signatory.
  signatories Json    @default("[]")
  sealUrl     String?

  // Step 6 — Banking Details (optional)
  banking Json @default("{\"bankName\":\"\",\"accountName\":\"\",\"accountNumber\":\"\",\"ifscCode\":\"\",\"branchName\":\"\"}")

  // Step 7 — Company Policies
  policies Json @default("{\"financialYearStartMonth\":4,\"leaveYearStartMonth\":1,\"workingHoursStart\":\"09:00\",\"workingHoursEnd\":\"18:00\",\"timezone\":\"Asia/Kolkata\",\"currency\":\"INR\",\"currencySymbol\":\"₹\",\"dateFormat\":\"DD-MM-YYYY\",\"timeFormat\":\"24\",\"language\":\"English\",\"defaultProbationDays\":90,\"defaultNoticeDays\":30,\"defaultRetirementAge\":58}")

  // Step 8 — Payroll & Attendance Preferences (admin-facing, much broader
  // than attendancePayrollPrefs above — see that field's comment).
  orgPayrollAttendancePrefs Json @default("{\"attendanceMethod\":[\"manual\"],\"defaultShiftStartTime\":\"09:30\",\"defaultShiftEndTime\":\"18:30\",\"defaultLateInThresholdMinutes\":15,\"defaultEarlyOutThresholdMinutes\":15,\"defaultMinHoursForPresent\":8,\"defaultMinHoursForHalfDay\":4,\"defaultWorkWeek\":\"monday-friday\",\"weekendDays\":[0,6],\"defaultWorkingHoursPerDay\":8,\"enableAttendanceImport\":true,\"enableAttendanceRegularization\":true,\"enableOvertime\":false,\"enableCompOff\":true,\"payrollCycle\":\"monthly\",\"salaryPaymentDay\":1,\"payrollFreezeDay\":25,\"enableLeaveEncashment\":true,\"enableTaxRegimeSelection\":true,\"defaultTaxRegime\":\"new\",\"defaultLeavePolicy\":\"\",\"enableHalfDayLeave\":true,\"enableSandwichLeave\":false,\"enableNegativeLeaveBalance\":false,\"carryForwardLeave\":true,\"maxCarryForwardLimit\":15}")

  // Step 9 — Document Numbering: { [type]: { label, format, resetRule,
  // counter, lastPeriodKey } }. employeeId here is descriptive only — the
  // row-locked employeeIdPrefix/employeeIdCounter columns above remain the
  // actual generator, not this JSON blob, so the two never drift.
  documentNumbering Json @default("{\"employeeId\":{\"label\":\"Employee ID\",\"format\":\"DP-{0000}\",\"resetRule\":\"never\",\"counter\":0,\"lastPeriodKey\":null},\"payslip\":{\"label\":\"Payslip\",\"format\":\"PS-{YYYYMM}-{0001}\",\"resetRule\":\"monthly\",\"counter\":0,\"lastPeriodKey\":null},\"offerLetter\":{\"label\":\"Offer Letter\",\"format\":\"OL-{YYYY}-{0001}\",\"resetRule\":\"yearly\",\"counter\":0,\"lastPeriodKey\":null},\"appointmentLetter\":{\"label\":\"Appointment Letter\",\"format\":\"AL-{YYYY}-{0001}\",\"resetRule\":\"yearly\",\"counter\":0,\"lastPeriodKey\":null},\"experienceLetter\":{\"label\":\"Experience Letter\",\"format\":\"EL-{YYYY}-{0001}\",\"resetRule\":\"yearly\",\"counter\":0,\"lastPeriodKey\":null},\"relievingLetter\":{\"label\":\"Relieving Letter\",\"format\":\"RL-{YYYY}-{0001}\",\"resetRule\":\"yearly\",\"counter\":0,\"lastPeriodKey\":null},\"salaryCertificate\":{\"label\":\"Salary Certificate\",\"format\":\"SC-{YYYY}-{0001}\",\"resetRule\":\"yearly\",\"counter\":0,\"lastPeriodKey\":null},\"fullFinalSettlement\":{\"label\":\"Full & Final Settlement\",\"format\":\"FNF-{YYYY}-{0001}\",\"resetRule\":\"yearly\",\"counter\":0,\"lastPeriodKey\":null},\"experienceCertificate\":{\"label\":\"Experience Certificate\",\"format\":\"EC-{YYYY}-{0001}\",\"resetRule\":\"yearly\",\"counter\":0,\"lastPeriodKey\":null}}")

  // Admin-added employee types beyond the built-in default list (see
  // default-employee-types.ts) — each entry { value, label }.
  customEmployeeTypes Json @default("[]")

  // Bare enforcement hook for a future plan/billing system — high default
  // so nothing breaks until real billing exists.
  maxEmployees Int @default(999999)

  users                    User[]
  departments              Department[]
  refreshTokens            RefreshToken[]
  holidays                 Holiday[]
  workLocations            WorkLocation[]
  leaveTypes               LeaveType[]
  leaveBalances            LeaveBalance[]
  leaves                   Leave[]
  compOffs                 CompOff[]
  salaryComponents         SalaryComponent[]
  payrollSettings          PayrollSettings?
  employeeSalaryComponents EmployeeSalaryComponent[]
  payrollTemplates         PayrollTemplate[]
  statutoryConfigVersions  StatutoryConfigVersion[]
  employeeTaxDeclarations  EmployeeTaxDeclaration[]
  taxSlabConfigs           TaxSlabConfig[]
  punches                  Punch[]
  attendances              Attendance[]
  attendanceImportBatches  AttendanceImportBatch[]
  overtimeRecords          OvertimeRecord[]
  performanceRatings       PerformanceRating[]
  leaveEncashments         LeaveEncashment[]
  payrollRuns              PayrollRun[]
  reimbursements           Reimbursement[]
  loans                    Loan[]
  loanRepayments           LoanRepayment[]
  settlements              Settlement[]
  offboardingCases         OffboardingCase[]
  auditLogs                AuditLog[]
  timelineEvents           EmployeeTimeline[]
  approvalDelegations      ApprovalDelegation[]
  policyDocuments          PolicyDocument[]
  documentRequirements     DocumentRequirement[]
  notifications            Notification[]
  employeeDocuments        EmployeeDocument[]
  employeeAssets           EmployeeAsset[]
  employeeRoleHistory      EmployeeRoleHistory[]
  employmentStatusHistory  EmploymentStatusHistory[]

  @@map("organizations")
}

model Department {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  name        String
  // Uppercased in DepartmentsService.create() — Prisma has no model-level
  // hooks like Sequelize's beforeValidate, so this is an explicit service
  // call rather than a DB-level guarantee.
  code        String
  description String  @default("")
  isActive    Boolean @default(true)

  departmentHeadId String?
  departmentHead   User?   @relation("DepartmentHead", fields: [departmentHeadId], references: [id])

  // Assigned geo-fence for self-punch validation (AttendanceService) — one
  // per department, not per-employee. Null = no enforcement for this dept.
  workLocationId String?
  workLocation   WorkLocation? @relation(fields: [workLocationId], references: [id])

  // Per-department shift/attendance policy, read by
  // AttendanceService.recalculateAttendanceForDay. Falls back to
  // Organization.attendancePayrollPrefs's default* fields when unset at
  // the org level too (see attendance-shift-config.ts).
  shiftStartTime           String @default("09:30")
  shiftEndTime             String @default("18:30")
  lateInThresholdMinutes   Int    @default(15)
  earlyOutThresholdMinutes Int    @default(15)
  minHoursForPresent       Float  @default(8)
  minHoursForHalfDay       Float  @default(4)
  // [0]=Sunday ... 6=Saturday.
  weeklyOffs               Json   @default("[0]")

  employees User[]    @relation("EmployeeDepartment")
  holidays  Holiday[]

  attendanceImportBatches AttendanceImportBatch[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, name])
  @@unique([organizationId, code])
  @@index([organizationId])
  @@map("departments")
}

model User {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  // Globally unique (not per-org) so login can resolve the tenant from the
  // email alone, same reasoning as the old system.
  email    String @unique
  password String
  name     String
  role     Role   @default(EMPLOYEE)

  // Corporate/company inbox, set up separately from the login email above
  // (often after IT provisions it post-joining) — nullable since it's
  // normally unknown at creation time; unique when set so two employees
  // can't share one. Credentials can be re-sent here once it exists via
  // POST /employees/:id/resend-credentials.
  officialEmail String? @unique

  // Forgot/reset-password — a SHA-256 hash of the raw token mailed to the
  // user (never store the raw token), unique so a hash lookup can find the
  // owning row directly. Both null once unset/consumed. 30-minute expiry
  // enforced in AuthService, not the DB.
  resetPasswordToken   String?   @unique
  resetPasswordExpires DateTime?

  isFounder          Boolean   @default(false)
  isActive           Boolean   @default(true)
  mustChangePassword Boolean   @default(true)
  emailVerified      Boolean   @default(true)
  lastLoginAt        DateTime?

  // Employee fields — Employee IS the User row, same as the old system
  // (no separate Employee entity). Unique per-org (not globally, unlike
  // email) via the composite unique index below, matching the old system's
  // users_org_employee_id_unique index exactly.
  employeeId       String
  designation      String           @default("")
  contactNumber    String           @default("")
  joiningDate      DateTime         @default(now())
  employeeType     String           @default("permanent")
  employmentStatus EmploymentStatus @default(ONBOARDING)

  // Leave-policy source of truth — separate from whatever's mirrored in
  // personalData below (the old system had a redundant copy there too; a
  // comment in the old code names this top-level one as authoritative).
  gender Gender?

  probationEndDate String?
  probationStatus  ProbationStatus?

  // Profile photo — a relativeKey through the existing generic files
  // module (POST /files/upload/profile-photos), not raw personalData.
  profileImage String?

  // One JSON blob for the "rich profile" fields the old system also kept
  // as a single loosely-structured object (dob/address/personalEmail/
  // bloodGroup, family + emergency contacts, free-text professional info,
  // previousEmployment[] capped at 3 client-side, bank details +
  // cancelledChequeUrl, statutory IDs, references[], profileCompleted/
  // profileCompletedAt) — normalizing every sub-object into its own table
  // would multiply migrations for fields nothing else ever joins against;
  // documents and assets DO get real tables below since those need actual
  // list/status/referential-integrity semantics.
  personalData Json @default("{}")

  departmentId String?
  department   Department? @relation("EmployeeDepartment", fields: [departmentId], references: [id])

  reportingManagerId String?
  reportingManager   User?   @relation("ReportingManager", fields: [reportingManagerId], references: [id])
  subordinates       User[]  @relation("ReportingManager")

  managedDepartments Department[] @relation("DepartmentHead")

  // { mutedCategories: NotificationCategory[], emailEnabled: boolean } —
  // mutedCategories filters GET /notifications; emailEnabled only gates
  // whether this user receives HR's broadcast emails (POST
  // /notifications/send with sendEmailToo) — per-event transactional
  // emails (leave/attendance/payroll decisions) always fire regardless,
  // same as the old system.
  notificationPreferences Json @default("{\"mutedCategories\":[],\"emailEnabled\":true}")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  refreshTokens                    RefreshToken[]
  createdWorkLocations             WorkLocation[]
  createdLeaveTypes                LeaveType[]
  leaveBalances                    LeaveBalance[]
  leaves                           Leave[]                   @relation("LeaveEmployee")
  leavesReviewed                   Leave[]                   @relation("LeaveReviewedBy")
  leavesLevel1Approved             Leave[]                   @relation("LeaveLevel1ApprovedBy")
  compOffs                         CompOff[]                 @relation("CompOffEmployee")
  compOffsApproved                 CompOff[]                 @relation("CompOffApprovedBy")
  createdSalaryComponents          SalaryComponent[]
  updatedPayrollSettings           PayrollSettings[]
  employeeSalaryComponents         EmployeeSalaryComponent[] @relation("EmployeeSalaryComponentEmployee")
  createdEmployeeSalaryComponents  EmployeeSalaryComponent[] @relation("EmployeeSalaryComponentCreatedBy")
  createdPayrollTemplates          PayrollTemplate[]
  createdStatutoryConfigVersions   StatutoryConfigVersion[]
  taxDeclarations                  EmployeeTaxDeclaration[]
  punches                          Punch[]
  attendances                      Attendance[]
  uploadedAttendanceImportBatches  AttendanceImportBatch[]   @relation("AttendanceImportUploadedBy")
  validatedAttendanceImportBatches AttendanceImportBatch[]   @relation("AttendanceImportValidatedBy")
  executedAttendanceImportBatches  AttendanceImportBatch[]   @relation("AttendanceImportExecutedBy")
  overtimeRecords                  OvertimeRecord[]          @relation("OvertimeEmployee")
  overtimeRecordsApproved          OvertimeRecord[]          @relation("OvertimeApprovedBy")
  performanceRatings               PerformanceRating[]       @relation("PerformanceRatingEmployee")
  performanceRatingsGiven          PerformanceRating[]       @relation("PerformanceRatingRatedBy")
  leaveEncashments                 LeaveEncashment[]         @relation("LeaveEncashmentEmployee")
  leaveEncashmentsApproved         LeaveEncashment[]         @relation("LeaveEncashmentApprovedBy")
  payrollRuns                      PayrollRun[]              @relation("PayrollRunEmployee")
  payrollRunsCalculated            PayrollRun[]              @relation("PayrollRunCalculatedBy")
  reimbursements                   Reimbursement[]           @relation("ReimbursementEmployee")
  reimbursementsApproved           Reimbursement[]           @relation("ReimbursementApprovedBy")
  loans                            Loan[]                    @relation("LoanEmployee")
  loansApproved                    Loan[]                    @relation("LoanApprovedBy")
  settlements                      Settlement[]              @relation("SettlementEmployee")
  settlementsProcessed             Settlement[]              @relation("SettlementProcessedBy")
  offboardingCases                 OffboardingCase[]         @relation("OffboardingCaseEmployee")
  offboardingCasesInitiated        OffboardingCase[]         @relation("OffboardingCaseInitiatedBy")
  offboardingCasesCompleted        OffboardingCase[]         @relation("OffboardingCaseCompletedBy")
  auditLogs                        AuditLog[]
  timelineEvents                   EmployeeTimeline[]        @relation("TimelineEmployee")
  timelineEventsPerformed          EmployeeTimeline[]        @relation("TimelinePerformedBy")
  delegationsGiven                 ApprovalDelegation[]      @relation("DelegationDelegator")
  delegationsReceived              ApprovalDelegation[]      @relation("DelegationDelegate")
  delegationsCreated               ApprovalDelegation[]      @relation("DelegationCreatedBy")
  policyDocumentsUploaded          PolicyDocument[]          @relation("PolicyDocumentUploadedBy")
  documentRequirementsCreated      DocumentRequirement[]     @relation("DocumentRequirementCreatedBy")
  notifications                    Notification[]
  organizationsInitialized         Organization[]            @relation("OrganizationInitializedBy")
  employeeDocuments                EmployeeDocument[]        @relation("EmployeeDocumentEmployee")
  employeeDocumentsReviewed        EmployeeDocument[]        @relation("EmployeeDocumentReviewedBy")
  assets                           EmployeeAsset[]           @relation("EmployeeAssetEmployee")
  assetsAllocated                  EmployeeAsset[]           @relation("EmployeeAssetAllocatedBy")
  roleHistoryEntries               EmployeeRoleHistory[]     @relation("RoleHistoryEmployee")
  roleHistoryChangedBy             EmployeeRoleHistory[]     @relation("RoleHistoryChangedBy")
  employmentStatusHistoryEntries   EmploymentStatusHistory[] @relation("StatusHistoryEmployee")
  employmentStatusHistoryChangedBy EmploymentStatusHistory[] @relation("StatusHistoryChangedBy")

  @@unique([organizationId, employeeId])
  @@index([organizationId])
  @@index([departmentId])
  @@map("users")
}

model RefreshToken {
  id             String       @id @default(uuid())
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Stored directly (not just derivable via userId) so the tenant-scope
  // Prisma extension never needs a special case for this model.
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  // SHA-256 hash of the raw token — the raw value is only ever returned
  // once, at issuance, and is never persisted. Mirrors the old system's
  // pattern for password-reset/email-verification tokens.
  tokenHash String @unique

  expiresAt           DateTime
  revokedAt           DateTime?
  // Set on rotation (see AuthService.refresh) — kept for audit/reuse-detection.
  replacedByTokenHash String?

  createdAt   DateTime @default(now())
  createdByIp String?
  userAgent   String?

  @@index([userId])
  @@index([organizationId])
  @@map("refresh_tokens")
}

// Mirrors the old MySQL backend's Holiday.type ENUM exactly (see
// holidayController.js ground truth).
enum HolidayType {
  NATIONAL
  STATE
  REGIONAL
  COMPANY
  OPTIONAL
}

model Holiday {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  name String
  // YYYY-MM-DD, stored as a plain string same as the old system — it's
  // always compared/sorted as an ISO date string, never a time-of-day.
  date String

  departmentId String? // null = company-wide
  department   Department? @relation(fields: [departmentId], references: [id])

  year        Int
  // isOptional is the behavioral flag (drives employee opt-in logic); type
  // is display/reporting taxonomy only — a state holiday can independently
  // be optional or not. Mirrors the old model's comment verbatim.
  isOptional  Boolean     @default(false)
  type        HolidayType @default(COMPANY)
  state       String?
  description String      @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@map("holidays")
}

// Mirrors the old MySQL backend's WorkLocation.fenceType ENUM exactly.
enum FenceType {
  CIRCLE
  RECTANGLE
  POLYGON
}

// A geo-fenced office/site HR has marked on the map. Multiple locations are
// supported (branches, WFH-exempt sites, etc.). Attendance/punch validation
// against these fences is Batch 6 — this is the HR-configuration side only.
model WorkLocation {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  name        String
  address     String @default("")
  description String @default("")

  latitude     Float
  longitude    Float
  radiusMeters Int   @default(200)

  // CIRCLE (legacy/default) keeps using latitude/longitude/radiusMeters
  // as-is. RECTANGLE/POLYGON store their geometry in `boundary` and also
  // keep latitude/longitude/radiusMeters populated with a derived centroid
  // + bounding radius (see geo-fence.ts's deriveCircleSummary) so any
  // consumer that only knows circles still gets a sensible equivalent.
  fenceType FenceType @default(CIRCLE)
  // circle: null. rectangle: { bounds: [[lat,lng],[lat,lng]] }. polygon:
  // { vertices: [[lat,lng], ...] } (>= 3 points, unlimited).
  boundary  Json?

  isActive Boolean @default(true)

  createdById String?
  createdBy   User?   @relation(fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  departments Department[]

  @@index([organizationId])
  @@map("work_locations")
}

enum AllocationType {
  FIXED_ANNUAL
  PRORATED_ON_JOINING
  EARNED_MONTHLY
  UNLIMITED
  NONE
}

enum AccrualFrequency {
  YEARLY
  HALF_YEARLY
  QUARTERLY
  MONTHLY
  BI_MONTHLY
}

model LeaveType {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  name         String
  code         String
  description  String  @default("")
  color        String  @default("#3b82f6")
  isActive     Boolean @default(true)
  isPaid       Boolean @default(true)
  displayOrder Int     @default(0)

  allocationType        AllocationType   @default(FIXED_ANNUAL)
  annualQuota           Float            @default(0)
  accrualFrequency      AccrualFrequency @default(YEARLY)
  accrualAmountPerCycle Float            @default(0)
  prorateOnJoining      Boolean          @default(true)

  // [] = applies to all. applicableGenders stores Gender enum values
  // (MALE/FEMALE/OTHER) and is enforced in leave-eligibility.ts.
  applicableDepartments   Json @default("[]")
  applicableEmployeeTypes Json @default("[]")
  applicableGenders       Json @default("[]")
  minServiceMonths        Int  @default(0)
  maxServiceMonths        Int?

  salaryImpactPercent   Float   @default(100)
  affectsLopCalculation Boolean @default(true)

  // approvalLevels/autoApprove* are read by the future Leave-requests
  // module, not this one. autoApproveIfNoAction/autoApproveDays are
  // carried for schema parity with the old system, where they were also
  // dead fields (no code path implemented auto-approval there either).
  requiresApproval      Boolean @default(true)
  approvalLevels        Int     @default(2)
  autoApproveIfNoAction Boolean @default(false)
  autoApproveDays       Int     @default(0)

  // Default mirrors the old system's rules object exactly.
  rules Json @default("{\"minDurationDays\":0.5,\"maxDurationDays\":null,\"noticePeriodDays\":0,\"allowBackdated\":false,\"maxBackdateDays\":0,\"allowFutureDated\":true,\"maxAdvanceDays\":null,\"allowHalfDay\":true,\"sandwichLeaveApplies\":false,\"restrictPrefixSuffixHoliday\":false,\"maxConsecutiveDays\":null,\"minGapBetweenRequestsDays\":0}")

  documentsRequired         Boolean @default(false)
  documentRequiredAfterDays Float?

  carryForward    Json @default("{\"allowed\":false,\"maxDays\":0,\"expiryMonths\":null}")
  negativeBalance Json @default("{\"allowed\":false,\"maxNegativeDays\":0}")
  encashment      Json @default("{\"allowed\":false,\"maxDaysPerYear\":0,\"minBalanceToRetain\":0}")

  createdById String?
  createdBy   User?   @relation(fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  balances         LeaveBalance[]
  leaves           Leave[]
  leaveEncashments LeaveEncashment[]

  @@unique([organizationId, name])
  @@unique([organizationId, code])
  @@index([organizationId])
  @@map("leave_types")
}

model LeaveBalance {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  employeeId  String
  employee    User      @relation(fields: [employeeId], references: [id])
  leaveTypeId String
  leaveType   LeaveType @relation(fields: [leaveTypeId], references: [id])
  year        Int

  opening            Float   @default(0)
  credited           Float   @default(0)
  availed            Float   @default(0)
  // Held-but-undecided total — subtracted only in the future Leave
  // module's "available for new request" calc, deliberately excluded from
  // `closing` below (matches the old system's two-different-"available"-
