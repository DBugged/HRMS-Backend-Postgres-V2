  // would multiply migrations for fields nothing else ever joins against;
  // documents and assets DO get real tables below since those need actual
  // list/status/referential-integrity semantics.
  personalData Json @default("{}")

  departmentId String?
  department   Department? @relation("EmployeeDepartment", fields: [departmentId], references: [id])

  // Per-employee override of the department's work location (geo-fence + state for state-wise statutory rules).
  // Effective location = workLocationId ?? department.workLocationId.
