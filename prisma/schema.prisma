  // comment in the old code names this top-level one as authoritative).
  gender Gender?

  probationEndDate String?
  probationStatus  ProbationStatus?
  // YYYY-MM-DD the employee was confirmed from (set when probation is confirmed, or the status is moved to Confirmed).
  confirmationDate String?

  // Profile photo — a relativeKey through the existing generic files
  // module (POST /files/upload/profile-photos), not raw personalData.
  profileImage String?

  // One JSON blob for the "rich profile" fields the old system also kept
  // as a single loosely-structured object (dob/address/personalEmail/
  // bloodGroup, family + emergency contacts, free-text professional info,
  // previousEmployment[] capped at 3 client-side, bank details +
  // cancelledChequeUrl, statutory IDs, references[], profileCompleted/
