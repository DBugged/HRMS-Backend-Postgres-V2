  updatedAt DateTime @updatedAt

  @@unique([employeeId, month, year, isFinalSettlement])
  @@index([organizationId, month, year])
  @@map("payroll_runs")
}

enum ReimbursementCategory {
  TRAVEL
  FUEL
  MOBILE
  INTERNET
  MEDICAL
  OTHER
}

enum ReimbursementStatus {
  PENDING
  APPROVED
  REJECTED
  PAID
}

model Reimbursement {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  employeeId String
  employee   User   @relation("ReimbursementEmployee", fields: [employeeId], references: [id])

  category    ReimbursementCategory @default(OTHER)
  amount      Float
  // YYYY-MM-DD, same plain-string convention as Leave.startDate.
  claimDate   String
  description String                @default("")
  // No file-storage infrastructure exists yet (Batch 9 deferral, same as
  // every other file field in backend-v2) — stored as a plain string, no
  // signed-URL resolution.
  receiptUrl  String                @default("")
  status      ReimbursementStatus   @default(PENDING)

  approvedById   String?
  approvedBy     User?   @relation("ReimbursementApprovedBy", fields: [approvedById], references: [id])
  reviewComments String  @default("")
  // Stamped once a PayrollRun pays this out — payroll deduction/payout
  // integration for reimbursements isn't built yet, same deferral as
  // LeaveEncashment.payrollRunId.
  payrollRunId   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId, employeeId])
  @@map("reimbursements")
}

enum LoanType {
  LOAN
  ADVANCE
}

enum LoanStatus {
  ACTIVE
  CLOSED
  CANCELLED
}

model Loan {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  employeeId String
  employee   User   @relation("LoanEmployee", fields: [employeeId], references: [id])

  loanType           LoanType   @default(LOAN)
  principal          Float
  // Annual %.
  interestRate       Float      @default(0)
  tenureMonths       Int
  emiAmount          Float
  startMonth         Int
  startYear          Int
  outstandingBalance Float
  status             LoanStatus @default(ACTIVE)
  reason             String     @default("")

  approvedById String?
  approvedBy   User?   @relation("LoanApprovedBy", fields: [approvedById], references: [id])

  repayments LoanRepayment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId, employeeId])
  @@map("loans")
}

model LoanRepayment {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  loanId String
  loan   Loan   @relation(fields: [loanId], references: [id])

  // Stamped when a PayrollRun deducts this EMI — payroll integration for
  // loan repayments isn't built yet, same deferral as
  // Reimbursement.payrollRunId. This endpoint currently only supports HR
  // manually recording a repayment.
  payrollRunId String?

  month              Int
  year               Int
  amount             Float
  principalComponent Float @default(0)
  interestComponent  Float @default(0)
  balanceAfter       Float @default(0)

  createdAt DateTime @default(now())

  @@index([organizationId, loanId])
  @@map("loan_repayments")
}

enum SettlementStatus {
  DRAFT
  PROCESSED
  PAID
}

// Full & Final settlement — old system's FullFinalSettlement, ported under
// a shorter name since this app has no other "settlement" concept to
// disambiguate from.
model Settlement {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  employeeId String
  employee   User   @relation("SettlementEmployee", fields: [employeeId], references: [id])

  // YYYY-MM-DD, same plain-string convention as Leave.startDate.
  lastWorkingDay String

  pendingSalaryAmount   Float @default(0)
  // Unlike the old system (which read a dead, always-zero legacy
  // User.leaveBalance.el JSON field — never written anywhere else in that
  // codebase), this sums (closing balance × rate/day) across every
  // LeaveType with encashment.allowed=true, using the real LeaveBalance
  // table the leave-encashments module already relies on. No
  // minBalanceToRetain cap here — the employee is leaving, so the full
  // balance is paid out.
  leaveEncashmentAmount Float @default(0)
  bonusAmount           Float @default(0)
  recoveriesAmount      Float @default(0)
  loanBalanceRecovered  Float @default(0)
  noticePeriodRecovery  Float @default(0)
  gratuityAmount        Float @default(0)
  netSettlementAmount   Float @default(0)

  status SettlementStatus @default(DRAFT)

  processedById String?
  processedBy   User?   @relation("SettlementProcessedBy", fields: [processedById], references: [id])

  payrollRunId String?     @unique
  payrollRun   PayrollRun? @relation(fields: [payrollRunId], references: [id])

  offboardingCases OffboardingCase[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId, employeeId])
  @@map("settlements")
}

enum OffboardingStatus {
  INITIATED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

// One row per employee exit — tracks the checklist that has to complete
// before the account is deactivated, mirroring the old system's
// OffboardingCase.
model OffboardingCase {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  employeeId String
  employee   User   @relation("OffboardingCaseEmployee", fields: [employeeId], references: [id])

  initiatedById String
  initiatedBy   User   @relation("OffboardingCaseInitiatedBy", fields: [initiatedById], references: [id])

  // YYYY-MM-DD, same plain-string convention as Leave.startDate.
  lastWorkingDay String
  reason         String?

  status OffboardingStatus @default(INITIATED)

  // Exit checklist — each flipped independently, all required before the
  // case can be marked complete.
  assetsReturned         Boolean @default(false)
  accessRevoked          Boolean @default(false)
  // Set automatically once exitInterviewResponses is submitted (see
  // OffboardingService.submitExitInterview) — there's no path to flip it
  // true without actually answering the questions.
  exitInterviewDone      Boolean @default(false)
  exitInterviewResponses Json?

  // Set once a Settlement has been linked for this exit.
  settlementId String?
  settlement   Settlement? @relation(fields: [settlementId], references: [id])

  notes String?

  completedById String?
  completedBy   User?     @relation("OffboardingCaseCompletedBy", fields: [completedById], references: [id])
  completedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId, employeeId])
  @@map("offboarding_cases")
}

enum AuditModule {
  AUTH
  EMPLOYEE
  ATTENDANCE
  LEAVE
  PAYROLL
  DEPARTMENT
  DOCUMENT
  HOLIDAY
  NOTIFICATION
  ORGANIZATION
}

// Records attendance changes, payroll changes, leave approvals, login
// activity, and profile edits — fire-and-forget writes from AuditLogService
// (write failures are swallowed, same as the old system's logAudit util,
// since a broken audit write should never fail the underlying action).
//
// This batch wires it into a representative sample of high-value write
// paths (login, employee deactivation, payroll lock/pay) as proof of
// integration, not a full retrofit of every mutating endpoint across the
// codebase — that's separate follow-up work given how much already exists.
model AuditLog {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  actorId String
  actor   User   @relation(fields: [actorId], references: [id])

  // e.g. 'LEAVE_APPROVED', 'PAYROLL_PROCESSED'.
  action    String
  module    AuditModule
  targetId  String?
  details   Json        @default("{}")
  ipAddress String      @default("")

  createdAt DateTime @default(now())

  @@index([organizationId, module])
  @@index([organizationId, actorId])
  @@map("audit_logs")
}

enum TimelineCategory {
  RECRUITMENT
  EMPLOYMENT
  ORGANIZATION
  PAYROLL
  ATTENDANCE_LEAVE
  PERFORMANCE
  COMPLIANCE
  EXIT
}

// Append-only log of an employee's 360° journey — every row is a fact
// about something that happened, never edited or overwritten afterward.
// Written via EmployeeTimelineService.logEvent() from the various
// services where each event actually occurs, mirroring how
// AuditLogService.log() is called — the two are deliberately fired from
// the same code paths so Timeline and Audit Log never drift apart.
model EmployeeTimeline {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  employeeId String
  employee   User   @relation("TimelineEmployee", fields: [employeeId], references: [id])

  category    TimelineCategory
  // e.g. 'DEPARTMENT_CHANGED' — see employee-timeline-events.ts EVENT_META.
  eventKey    String
  title       String
  description String?          @default("")

  occurredAt DateTime @default(now())

  // null = system-generated.
  performedById String?
  performedBy   User?   @relation("TimelinePerformedBy", fields: [performedById], references: [id])

  remarks         String? @default("")
  relatedDocument String? @default("")
  status          String? @default("")
  // Free-form event-specific context (old/new values, etc.).
  metadata        Json    @default("{}")

  createdAt DateTime @default(now())

  @@index([organizationId, employeeId, occurredAt])
  @@map("employee_timeline")
}

// Temporarily routes a manager's leave/regularization approvals to another
// MANAGER/HR/ADMIN for a date range (e.g. the manager is themself on
// leave). Checked alongside reportingManagerId in LeavesService.review()
// when resolving who can approve a given employee's request.
model ApprovalDelegation {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  delegatorId String
  delegator   User   @relation("DelegationDelegator", fields: [delegatorId], references: [id])
  delegateId  String
  delegate    User   @relation("DelegationDelegate", fields: [delegateId], references: [id])

  // YYYY-MM-DD, same plain-string convention as Leave.startDate.
  fromDate String
  toDate   String

  isActive Boolean @default(true)

  createdById String
  createdBy   User   @relation("DelegationCreatedBy", fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId, delegatorId])
  @@map("approval_delegations")
}

enum PolicyDocType {
  PDF
  IMAGE
  VIDEO
  URL
}

enum PolicyVisibility {
  EVERYONE
  HR_ONLY
  MANAGERS
  DEPARTMENTS
  EMPLOYEES
}

// Company-wide policy/document library (distinct from DocumentRequirement
// below, which is the master list of per-employee document *requirements*).
model PolicyDocument {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  title    String
  category String        @default("General")
  docType  PolicyDocType @default(PDF)

  // A relativeKey from POST /files/upload/documents (organizationId/
  // documents/uuid.ext) when we host the file, or a raw http(s):// URL when
  // docType=URL. Never a signed URL — those are minted fresh per response.
  fileUrl  String
  fileName String

  isPublished Boolean @default(true)

  uploadedById String?
  uploadedBy   User?   @relation("PolicyDocumentUploadedBy", fields: [uploadedById], references: [id])

  visibility         PolicyVisibility @default(EVERYONE)
  visibleDepartments String[]         @default([])
  visibleEmployees   String[]         @default([])

  // New-version uploads create a new row (not an update) chained via
  // previousVersionId, and retire the old row by flipping isPublished to
  // false — version history is a linked list of rows, mirroring the old
  // system exactly.
  version           Int     @default(1)
  previousVersionId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId, createdAt])
  @@map("policy_documents")
}

// HR/Admin-defined master list of expected employee document types (NDA,
// Police Verification, ...), on top of the app's built-in defaults. Each
// employee's actual uploaded file still lives on the Employee attachment
// endpoints — this table is only "what's expected", not the uploads
// themselves.
model DocumentRequirement {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  name String

  isMandatory  Boolean @default(false)
  // Soft-disable, not a delete — matches the old system: a disabled
  // requirement stops appearing as expected/missing but any already-
  // uploaded documents against it are untouched.
  isActive     Boolean @default(true)
  displayOrder Int     @default(0)

  createdById String?
  createdBy   User?   @relation("DocumentRequirementCreatedBy", fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, name])
  @@map("document_requirements")
}

enum NotificationCategory {
  LEAVE
  REGULARIZATION
  PAYROLL
  ATTENDANCE
  GENERAL
  // Defined for parity with the old system's enum, but nothing creates one
  // — no controller old-side ever fires an ONBOARDING-category
  // notification. Kept for schema fidelity, not because it's used.
  ONBOARDING
}

model Notification {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  userId String
  user   User   @relation(fields: [userId], references: [id])

  title    String
  message  String
  category NotificationCategory @default(GENERAL)
  isRead   Boolean              @default(false)
  // Defined for parity with the old model, but never populated by any
  // trigger site old-side (dead field there too) — carried over as-is.
  link     String               @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId, userId, isRead])
  @@map("notifications")
}

enum EmployeeDocumentStatus {
  PENDING
  APPROVED
  REJECTED
}

// Real table, not a JSON array like the old system — lets a review action
// join back to the reviewer and gives normal list/status semantics. Files
// themselves go through the existing generic files module (POST
// /files/upload/documents) — this row only ever stores the resulting
// relativeKey, matching the "upload-then-PATCH/POST" convention already
// established for policy documents, branding assets, etc.
model EmployeeDocument {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  employeeId String
  employee   User   @relation("EmployeeDocumentEmployee", fields: [employeeId], references: [id])

  // Free string, matched loosely against a hardcoded default list
  // (PAN Card / Aadhaar Card / Passport Photo / Educational Certificate /
  // Relieving Letter or Experience Certificate / Other) and the org's own
  // DocumentRequirement master list — same as the old system.
  docType  String
  fileName String
  fileUrl  String

  status       EmployeeDocumentStatus @default(PENDING)
  reviewReason String?
  reviewedById String?
  reviewedBy   User?                  @relation("EmployeeDocumentReviewedBy", fields: [reviewedById], references: [id])
  reviewedAt   DateTime?

  uploadedAt DateTime @default(now())

  @@index([organizationId, employeeId])
  @@map("employee_documents")
}

enum AssetStatus {
  ALLOCATED
  RETURNED
  LOST
}

// assetType is deliberately free-text, not an enum — the old system had a
// 6-value ENUM that didn't match its own frontend's much larger dropdown
// (Laptop/Desktop/MacBook/Monitor/... 25+ options), so most real
// allocations there silently fell through to "Other". Not a behavior worth
// preserving.
model EmployeeAsset {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  employeeId String
  employee   User   @relation("EmployeeAssetEmployee", fields: [employeeId], references: [id])

  assetType String
  assetName String
  assetTag  String?

  status        AssetStatus @default(ALLOCATED)
  allocatedDate String
  returnedDate  String?
  notes         String?

  allocatedById String
  allocatedBy   User   @relation("EmployeeAssetAllocatedBy", fields: [allocatedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId, employeeId])
  @@map("employee_assets")
}

// Append-only audit trail of role/designation/department changes —
// written automatically inside EmployeesService.update() whenever one of
// those three fields actually changes, mirroring the old system's
// logAudit-adjacent behavior.
model EmployeeRoleHistory {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  employeeId String
  employee   User   @relation("RoleHistoryEmployee", fields: [employeeId], references: [id])

  previousRole         Role?
  newRole              Role?
  previousDesignation  String?
  newDesignation       String?
  previousDepartmentId String?
  newDepartmentId      String?

  changedById String
  changedBy   User     @relation("RoleHistoryChangedBy", fields: [changedById], references: [id])
  changedAt   DateTime @default(now())

  @@index([organizationId, employeeId])
  @@map("employee_role_history")
}

// Append-only audit trail of employmentStatus transitions.
model EmploymentStatusHistory {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  employeeId String
  employee   User   @relation("StatusHistoryEmployee", fields: [employeeId], references: [id])

  previousStatus EmploymentStatus?
  newStatus      EmploymentStatus
  note           String?

  changedById String
  changedBy   User     @relation("StatusHistoryChangedBy", fields: [changedById], references: [id])
  changedAt   DateTime @default(now())

  @@index([organizationId, employeeId])
  @@map("employment_status_history")
}
