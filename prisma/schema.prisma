model RefreshToken {
  id             String       @id @default(uuid())
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Stored directly (not just derivable via userId) so the tenant-scope
  // Prisma extension never needs a special case for this model.
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  // SHA-256 hash of the raw token — the raw value is only ever returned
  // once, at issuance, and is never persisted. Mirrors the old system's
  // pattern for password-reset/email-verification tokens.
  tokenHash String @unique

  expiresAt           DateTime
  revokedAt           DateTime?
  // Set on rotation (see AuthService.refresh) — kept for audit/reuse-detection.
  replacedByTokenHash String?

  createdAt   DateTime @default(now())
  createdByIp String?
  userAgent   String?

  @@index([userId])
  @@index([organizationId])
  @@map("refresh_tokens")
}

// Mirrors the old MySQL backend's Holiday.type ENUM exactly (see
// holidayController.js ground truth).
enum HolidayType {
  NATIONAL
  STATE
  REGIONAL
  COMPANY
  OPTIONAL
}

model Holiday {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  name String
  // YYYY-MM-DD, stored as a plain string same as the old system — it's
  // always compared/sorted as an ISO date string, never a time-of-day.
  date String

  departmentId String? // null = company-wide
  department   Department? @relation(fields: [departmentId], references: [id])

  year        Int
  // isOptional is the behavioral flag (drives employee opt-in logic); type
  // is display/reporting taxonomy only — a state holiday can independently
  // be optional or not. Mirrors the old model's comment verbatim.
  isOptional  Boolean     @default(false)
  type        HolidayType @default(COMPANY)
  state       String?
  description String      @default("")
  // Deactivating keeps the record (audit history, past-year reporting)
  // while excluding it from attendance/leave-tracker/dashboard/leave-
  // eligibility calculations that read the calendar going forward — see
  // every `isActive: true` filter alongside a holiday.findMany/findFirst.
  isActive    Boolean     @default(true)
  // Loaded from a calendar upload after its date had already passed. Saved inactive, so nothing already calculated
  // (attendance, leave, overtime, payroll all read only active holidays) changes, and read-only like every past
  // holiday; the flag lets the calendar still show it as a past holiday instead of an ordinary deactivated one.
  isReference Boolean     @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@map("holidays")
}

// Org-scoped, occasion-based email templates (birthday wishes, work
// anniversaries, and future occasions) — subject/bodyHtml support
// {{placeholder}} substitution, rendered by EmailTemplatesService.render().
// occasionKey is a free-form string, not a Prisma enum, so a new occasion
// (e.g. 'WORK_ANNIVERSARY_MILESTONE') never needs a migration to add — only
// a new default row and a caller that looks it up. v1 keeps one active
// template per occasion per org (@@unique below); versioning/multiple
// templates per occasion is deferred — see email-template-defaults.ts.
model EmailTemplate {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  // e.g. 'BIRTHDAY', 'WORK_ANNIVERSARY' — deliberately a plain string, not
  // an enum, so new occasions are trivially addable later.
  occasionKey String
  name        String

  // Both support {{employeeName}}, {{years}}, {{companyName}},
  // {{companyPhone}}, {{companyWebsite}}, {{companyEmail}},
  // {{companyAddress}} — see render() for the substitution rules.
  subject  String
  bodyHtml String @db.Text

  // Whether sendWishesForOrg's cc list (all other active employees) is
  // applied when this template is used — an admin can opt an occasion out
  // of the org-wide cc without disabling the template entirely.
  ccAllActive Boolean @default(true)
  isActive    Boolean @default(true)

  // False only for the two seedDefaults() rows (BIRTHDAY, WORK_ANNIVERSARY)
  // — those are cron-triggered by HrEventsService and can't be deleted
  // (only disabled via isActive), just renamed/re-edited. A custom
  // (isCustom: true) template has no automatic trigger; it's sent manually
  // via EmailTemplatesController's send endpoint and can be deleted freely.
  isCustom Boolean @default(true)

  // Groups this template on the frontend's Email Templates table (General,
  // Attendance, Leave & Comp-Off, Payroll & Finance, Exit, Documents,
  // Account & Access — see email-template-categories.ts). A built-in row is
  // seeded with its EMAIL_TEMPLATE_DEFAULTS entry's category; a custom row
  // defaults to 'General' at create time and can be changed like any other
  // field.
  category String @default("General")

  // Which of Organization.emailSignatures this template's email uses when
  // sent — null means "whichever one has isDefault:true". Not a real FK
  // (emailSignatures is a JSON list, not its own table) — validated
  // against the org's current list at write time instead.
  signatureId String?

  // Who last saved this row — surfaced next to updatedAt on the Email
  // Templates table so a Founder/HR Admin can see who touched it before
  // they open it, since every ADMIN/HR user in the org can edit every
  // template (see email-templates.controller.ts). Null for a row no one
  // has edited since it was seeded.
  updatedById String?
  updatedBy   User?   @relation("EmailTemplateUpdatedBy", fields: [updatedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, occasionKey])
  @@index([organizationId])
  @@map("email_templates")
}

// Which extra data source a letter template needs beyond the always-
// available employee/org variables — the one thing about a letter's
// content that genuinely can't be admin-authored (it names a real
// prerequisite record: OffboardingCase/PayrollRun/Settlement), everything
// else (name, key, title, body text, addressing style) is fully
// admin-configurable. See LettersService.generate()'s per-profile fetch.
enum LetterDataProfile {
  BASIC // just employee/org/date variables
  EXIT // + lastWorkingDay, from the employee's latest OffboardingCase
  PAYROLL // + salary figures, from the employee's latest processed PayrollRun
  SETTLEMENT // + settlement breakdown, from the employee's latest Settlement
}

// Org-scoped, admin/HR-authored letter templates — Offer Letter/
// Appointment Letter/Relieving Letter/Experience Letter/Experience
// Certificate/Salary Certificate/Full & Final Settlement start out
// seeded (isCustom: false, same convention as EmailTemplate's Birthday/
// Work Anniversary), but every field including body text is editable, and
// an admin can create entirely new custom letter types beyond those 7 —
// `key` doubles as the Document Numbering entry name (organizations/
// document-numbering.ts's issueDocumentNumber already accepts an
// arbitrary key) and the GET /employees/:id/letters/:key route param, so
// a new custom template is immediately numbered and downloadable with no
// other configuration required.
model LetterTemplate {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  key   String
  name  String
  // PDF heading — supports the same {{placeholder}} substitution as
  // bodyText.
  title String

  // true ("Dear {{employeeName}},") vs false ("This is to certify..." /
  // "To Whomsoever It May Concern") — see letter-pdf.service.ts.
  addressedToEmployee Boolean           @default(true)
  dataProfile         LetterDataProfile @default(BASIC)

  // Paragraphs are plain lines separated by a blank line; {{placeholder}}
  // tokens substituted at generation time (see LettersService for the
  // full variable list, which depends on dataProfile).
  bodyText String @db.Text

  isActive Boolean @default(true)
  // False only for the 7 seeded built-in keys — can't be deleted (Document
  // Numbering and this app's own onboarding/exit flows point at those
  // exact keys), only disabled/re-edited. A custom template can be
  // deleted freely.
  isCustom Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, key])
  @@index([organizationId])
  @@map("letter_templates")
}

// A saved per-employee, per-letter-key override of a LetterTemplate's
// rendered title/body — HR edits the wording for one specific employee
// (e.g. a one-off clause) via the Send Letter modal's "Save" action. Once
// saved, this row — not the template's own {{placeholder}} rendering —
// becomes what both Download and Send produce for that employee+key, until
// it's reset. The LetterTemplate itself, and every other employee's copy,
// are untouched. See LettersService.computeLetterContent.
model LetterOverride {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  employeeId String
  employee   User   @relation("LetterOverrideEmployee", fields: [employeeId], references: [id])

  // Matches LetterTemplate.key — not a foreign key to it (a template can be
  // edited/re-keyed independently; this just needs the string to match at
  // read time, same loose coupling occasionKey/EmailTemplate already uses).
  key String

  // Already-rendered, human-edited text — no {{placeholder}} substitution
  // is re-applied to these; see the Body field's own \n-per-paragraph
  // convention in LettersService.
  title String
  body  String @db.Text

  updatedById String?
  updatedBy   User?   @relation("LetterOverrideUpdatedBy", fields: [updatedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, employeeId, key])
  @@index([organizationId, employeeId])
  @@map("letter_overrides")
}

// Per-employee visibility override for a small set of RESTRICTED_LETTER_KEYS
// (see letters.service.ts) — disciplinary/sensitive letters (Warning,
// Suspension, Show-Cause Notice) that must not be self-servable by every
// employee just because the template is org-wide active, unlike routine
// letters (Offer, NDA, ...) which stay visible/downloadable to everyone by
// default with no row here at all. Absence of a row (or enabled: false)
// means NOT visible for a restricted key; presence with enabled: true is an
// explicit HR/Admin grant. Only ever consulted for the acting employee's
// own self-service view/download — HR/Admin/Manager acting on someone
// else's record always bypass this (see LettersService).
model EmployeeLetterAccess {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  employeeId String
  employee   User   @relation("EmployeeLetterAccessEmployee", fields: [employeeId], references: [id])

  // Matches LetterTemplate.key — same loose string coupling as
  // LetterOverride.key above, not a foreign key.
  key     String
  enabled Boolean @default(true)

  enabledById String?
  enabledBy   User?   @relation("EmployeeLetterAccessGrantedBy", fields: [enabledById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, employeeId, key])
  @@index([organizationId, employeeId])
  @@map("employee_letter_access")
}

// Mirrors the old MySQL backend's WorkLocation.fenceType ENUM exactly.
enum FenceType {
  CIRCLE
  RECTANGLE
  POLYGON
}

// A geo-fenced office/site HR has marked on the map. Multiple locations are
// supported (branches, WFH-exempt sites, etc.). Attendance/punch validation
// against these fences is Batch 6 — this is the HR-configuration side only.
// Where an employee is hired decides how HRA is set up: METRO (the eight HRA cities, 50% of Basic), NON_METRO (40%) or
// RURAL (a village / rural area - no HRA by default).
enum CityClass {
  METRO
  NON_METRO
  RURAL
}

model WorkLocation {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  name        String
  address     String    @default("")
  description String    @default("")
  // Indian state/UT this location is in ('' = not set). Drives state-wise statutory rules — today the
  // Labour Welfare Fund rate (an employee's state is their department's work location's state).
  // Canonical spelling from common/indian-states.ts.
  state       String    @default("")
  // The city or town, and its class for HRA (suggested from the city by common/hra-cities.ts, editable).
  city        String    @default("")
  cityClass   CityClass @default(NON_METRO)

  latitude     Float
  longitude    Float
  radiusMeters Int   @default(200)

  // CIRCLE (legacy/default) keeps using latitude/longitude/radiusMeters
  // as-is. RECTANGLE/POLYGON store their geometry in `boundary` and also
  // keep latitude/longitude/radiusMeters populated with a derived centroid
  // + bounding radius (see geo-fence.ts's deriveCircleSummary) so any
  // consumer that only knows circles still gets a sensible equivalent.
  fenceType FenceType @default(CIRCLE)
  // circle: null. rectangle: { bounds: [[lat,lng],[lat,lng]] }. polygon:
  // { vertices: [[lat,lng], ...] } (>= 3 points, unlimited).
  boundary  Json?

  isActive Boolean @default(true)

  createdById String?
  createdBy   User?   @relation(fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  departments Department[]
  employees   User[]       @relation("EmployeeWorkLocation")

  @@index([organizationId])
  @@map("work_locations")
}

// Named shift template (Organization Structure > Work Configuration >
// Work Schedules) — "General Shift, Mon-Fri 09:30-18:30, 1hr break".
// Assigning one to a department (WorkSchedulesService.assign) copies
// startTime/endTime/workingDays onto that Department's own
// shiftStartTime/shiftEndTime/weeklyOffs fields, which is what
// AttendanceService actually reads — this model itself is never read by
// attendance calculation, only by this management screen and the
// Department.workScheduleId traceability link.
model WorkSchedule {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  name String

  // Days actually worked, 0=Sunday ... 6=Saturday — the inverse of
  // Department.weeklyOffs (which lists days off instead). Kept as the
  // "positive" list here since a schedule is naturally described by what
  // days it covers, not what it excludes.
  workingDays Json @default("[1,2,3,4,5]")

  startTime    String
  endTime      String
  breakMinutes Int    @default(60)

  // Days in this list are excluded from workingDays' plain "off every
  // week" treatment and instead off only on the given occurrence(s) of the
  // month — e.g. [{"day":6,"occurrences":[2,4]}] = 2nd/4th Saturday off,
  // 1st/3rd/5th worked. Empty by default (every non-working day is off
  // every week, the original behavior). Shape matches
  // attendance-shift-config.ts's WeeklyOffEntry (object form only — a day
  // here is never also in workingDays; see WorkSchedulesService.assign).
  alternateWeeklyOffs Json @default("[]")

  isActive Boolean @default(true)

  departments Department[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("work_schedules")
}

enum AllocationType {
  FIXED_ANNUAL
  PRORATED_ON_JOINING
  EARNED_MONTHLY
  UNLIMITED
  NONE
  // One-off leave granted per qualifying event (maternity, paternity, adoption...) through LeaveGrant: never
  // credited yearly, and an unused grant stays available across calendar years.
  EVENT_BASED
}

// UPFRONT: the whole quota is credited when the year's balance row is created. PERIODIC: it is credited in instalments
// (see LeaveType.accrualFrequency) by the nightly accrual run, each one recorded in leave_accrual_entries.
enum LeaveAccrualMode {
  UPFRONT
  PERIODIC
}

// When in its period an instalment is credited.
enum AccrualTiming {
  START
  END
}

/// Where a periodic type's cycles are counted from: the organisation's leave year, or each employee's own joining date.
enum AccrualBasis {
  LEAVE_YEAR
  JOINING_ANNIVERSARY
}

enum AccrualFrequency {
  YEARLY
  HALF_YEARLY
  QUARTERLY
  MONTHLY
  BI_MONTHLY
}

model LeaveType {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  name               String
  code               String
  description        String  @default("")
  color              String  @default("#3b82f6")
  isActive           Boolean @default(true)
  isPaid             Boolean @default(true)
  displayOrder       Int     @default(0)
  // Hides this leave type's column from the Leave Tracker balances view and export. Display only: balances,
  // applying for leave and eligibility are unaffected.
  showInLeaveTracker Boolean @default(true)

  // True only for the rows seedDefaults() creates at registration (Earned
  // Leave, Comp-Off, etc.) — several modules (leaves/leave-tracker via
  // LEAVE_TYPE_CODES, see common/reserved-codes.ts) look these up by exact
  // code, so name/code are locked for these once created. Everything else
  // (quota, accrual, applicability, carry forward...) stays editable — an
  // org still needs to tune its own policy on top of the seeded defaults.
  isSystemDefault Boolean @default(false)

  allocationType        AllocationType   @default(FIXED_ANNUAL)
  annualQuota           Float            @default(0)
  accrualFrequency      AccrualFrequency @default(YEARLY)
  accrualAmountPerCycle Float            @default(0)
  // PERIODIC accrual (frequency = accrualFrequency; amount = accrualAmountPerCycle, or quota x months / 12 when 0).
  accrualMode           LeaveAccrualMode @default(UPFRONT)
  accrualBasis          AccrualBasis     @default(LEAVE_YEAR)
  accrueAt              AccrualTiming    @default(END)
  // Accrual stops once the balance reaches this many days (null = no cap).
  maxBalance            Float?
  // First leave year the PERIODIC mode applies to; earlier years keep their upfront credit. Set when an existing type is
  // switched to PERIODIC mid-year, so nobody loses days already granted. Null = from the start.
  periodicFromYear      Int?
  prorateOnJoining      Boolean          @default(true)

  // [] = applies to all. applicableGenders stores Gender enum values
  // (MALE/FEMALE/OTHER) and is enforced in leave-eligibility.ts.
  applicableDepartments   Json @default("[]")
  applicableEmployeeTypes Json @default("[]")
  applicableGenders       Json @default("[]")
  minServiceMonths        Int  @default(0)
  maxServiceMonths        Int?

  salaryImpactPercent   Float   @default(100)
  affectsLopCalculation Boolean @default(true)

  // autoApproveIfNoAction/autoApproveHours drive LeavesService's
  // autoApprovePendingLeaves cron — a PENDING leave of this type past
  // autoApproveHours since createdAt with no reviewer decision gets
  // force-approved. Hours (not days) so a same-day SLA is expressible.
  requiresApproval      Boolean @default(true)
  approvalLevels        Int     @default(2)
  autoApproveIfNoAction Boolean @default(false)
  autoApproveHours      Int     @default(0)

  // Default mirrors the old system's rules object exactly.
  rules Json @default("{\"minDurationDays\":0.5,\"maxDurationDays\":null,\"noticePeriodDays\":0,\"allowBackdated\":false,\"maxBackdateDays\":0,\"allowFutureDated\":true,\"maxAdvanceDays\":null,\"allowHalfDay\":true,\"sandwichLeaveApplies\":false,\"restrictPrefixSuffixHoliday\":false,\"maxConsecutiveDays\":null,\"minGapBetweenRequestsDays\":0}")

  documentsRequired         Boolean @default(false)
  // Whether this type's balance counts toward the "Total Leave Balance" /
  // dashboard "Leave Balance" figures. Off for one-off, event-based leave
  // (Maternity, Paternity, Adoption, Bereavement, Marriage, Study) so the
  // total reflects leave an employee can actually spend any time.
  countInTotalBalance       Boolean @default(true)
  documentRequiredAfterDays Float?

  carryForward    Json @default("{\"allowed\":false,\"maxDays\":0,\"expiryMonths\":null}")
  negativeBalance Json @default("{\"allowed\":false,\"maxNegativeDays\":0}")
  encashment      Json @default("{\"allowed\":false,\"maxDaysPerYear\":0,\"minBalanceToRetain\":0}")

  // Only read when allocationType = EVENT_BASED (annualQuota is then the maximum days per event):
  // { unit: 'CALENDAR_DAYS' | 'WORKING_DAYS', repeatPolicy: 'ONCE_PER_EVENT' | 'MIN_INTERVAL',
  //   minIntervalMonths: number, effectiveFrom: 'YYYY-MM-DD' | null }
  eventGrant Json @default("{}")

  createdById String?
  createdBy   User?   @relation(fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  balances         LeaveBalance[]
  leaves           Leave[]
  leaveEncashments LeaveEncashment[]
  leaveGrants      LeaveGrant[]
  grantRequests    LeaveGrantRequest[]
  accrualEntries   LeaveAccrualEntry[]

  @@unique([organizationId, name])
  @@unique([organizationId, code])
  @@index([organizationId])
  @@map("leave_types")
}

model LeaveBalance {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  employeeId  String
  employee    User      @relation(fields: [employeeId], references: [id])
  leaveTypeId String
  leaveType   LeaveType @relation(fields: [leaveTypeId], references: [id])
  year        Int

  opening            Float   @default(0)
  credited           Float   @default(0)
  availed            Float   @default(0)
  // Held-but-undecided total — subtracted only in the future Leave
  // module's "available for new request" calc, deliberately excluded from
  // `closing` below (matches the old system's two-different-"available"-
  // semantics design, not an oversight).
  pending            Float   @default(0)
  encashed           Float   @default(0)
  adjusted           Float   @default(0)
  carriedForwardOut  Float   @default(0)
  // YYYY-MM-DD, same plain-string convention as Holiday.date.
  carriedInExpiresOn String?
  // Maintained-on-write by LeaveBalanceService.recalculate(), never
  // computed-on-read.
  closing            Float   @default(0)
  // Period key of the last successful creditAccrual() run for this row —
  // e.g. "2026-08" for MONTHLY, "2026-Q3" for QUARTERLY, "2026" for
  // YEARLY (see accrual-period.ts). Lets creditAccrual skip an employee
  // it already credited for the current cycle instead of unconditionally
  // re-adding accrualAmountPerCycle on every call (a double-click used to
  // double-credit silently).
  lastAccrualPeriod  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, employeeId, leaveTypeId, year])
  @@index([organizationId])
  @@map("leave_balances")
}

enum LeaveAccrualSource {
  SCHEDULED
  MANUAL
}

// One credit of a PERIODIC leave type: employee x type x period. The unique key makes the nightly run idempotent, and the
// rows are the audit trail of how a balance's `credited` came about.
model LeaveAccrualEntry {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  employeeId  String
  employee    User      @relation("LeaveAccrualEmployee", fields: [employeeId], references: [id])
  leaveTypeId String
  leaveType   LeaveType @relation(fields: [leaveTypeId], references: [id])

  // The leave-year key the credit went to and the period it is for (first day, YYYY-MM-DD).
  year        Int
  periodStart String
  periodEnd   String
  days        Float
  source      LeaveAccrualSource @default(SCHEDULED)
  createdById String?

  createdAt DateTime @default(now())

  @@unique([organizationId, employeeId, leaveTypeId, periodStart])
  @@index([organizationId, employeeId, year])
  @@map("leave_accrual_entries")
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
  RETURNED
}

enum HalfDaySession {
  FIRST_HALF
  SECOND_HALF
}

model Leave {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  employeeId  String
  employee    User      @relation("LeaveEmployee", fields: [employeeId], references: [id])
  leaveTypeId String
  leaveType   LeaveType @relation(fields: [leaveTypeId], references: [id])

  // Point-in-time snapshot of the employee's department at application
  // time — same reasoning as Attendance.departmentId's comment: a
  // mid-month transfer previously re-attributed every past leave to the
  // new department in any department-filtered report, since department
  // was always resolved live via the employee's *current* departmentId.
  // Null on rows created before this column existed (backfilled once,
  // approximately, at migration time) and never overwritten afterward.
  departmentId String?

  // YYYY-MM-DD, same plain-string convention as Holiday.date.
  startDate      String
  endDate        String
  isHalfDay      Boolean         @default(false)
  halfDaySession HalfDaySession?
  totalDays      Float
  remarks        String          @default("")
  attachmentUrl  String?

  status         LeaveStatus @default(PENDING)
  reviewedById   String?
  reviewedBy     User?       @relation("LeaveReviewedBy", fields: [reviewedById], references: [id])
  // Who cancelled it and when (the employee, or HR/Admin on their behalf); null until cancelled.
  cancelledById  String?
  cancelledBy    User?       @relation("LeaveCancelledBy", fields: [cancelledById], references: [id])
  cancelledAt    DateTime?
  reviewedAt     DateTime?
  reviewComments String      @default("")

  // Carried for schema fidelity — no endpoint in this codebase ever sets
  // it true (same as the old system: no "HR applies on behalf of" flow
  // for regular Leave, unlike CompOff's employeeId override).
  appliedOnBehalfOf Boolean @default(false)
  editedFromLeaveId String?
  // [{ year, days }] when the leave spans New Year: the days charged to each year's balance (they add up to totalDays).
  // Null for a leave inside one year, whose days all belong to its start year.
  yearSplit         Json?

  // Two-level approval (dept-head then HR), capped at 2, flat fields
  // rather than a separate approval-history table — mirrors the old
  // system exactly (a real audit trail would come from AuditLog/
  // EmployeeTimeline, both Batch 9, so there's no separate trail here
  // yet either).
  level1ApprovedById String?
  level1ApprovedBy   User?     @relation("LeaveLevel1ApprovedBy", fields: [level1ApprovedById], references: [id])
  level1ApprovedAt   DateTime?
  level1Comments     String    @default("")

  // An approved leave that has already started cannot be cancelled by the employee directly; they ask instead, and a
  // manager / HR / Admin decides. cancelRequestedAt is set while a request is waiting; a declined one is cleared and
  // the approver's reason is kept in cancelRequestDeclinedComments so the employee can see it.
  cancelRequestedAt             DateTime?
  cancelRequestReason           String    @default("")
  cancelRequestDeclinedComments String    @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([employeeId])
  @@index([organizationId, status])
  @@index([organizationId, createdAt])
  @@index([organizationId, employeeId, startDate])
  @@index([organizationId, status, startDate])
  @@map("leaves")
}

enum CompOffStatus {
  PENDING
  APPROVED
  REJECTED
  AVAILED
  PARTIALLY_AVAILED
  EXPIRED
}

model CompOff {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  employeeId    String
  employee      User    @relation("CompOffEmployee", fields: [employeeId], references: [id])
  earnedForDate String
  reason        String  @default("")
  daysEarned    Float   @default(1)
  // YYYY-MM-DD. Computed at creation as earnedForDate + the org's
  // PayrollSettings.compOffExpiryDays; null (days = 0) means never expires.
  expiryDate    String?

  status       CompOffStatus @default(PENDING)
  daysAvailed  Float         @default(0)
  approvedById String?
  approvedBy   User?         @relation("CompOffApprovedBy", fields: [approvedById], references: [id])
  approvedAt   DateTime?
  // The reviewer's note on the decision (why it was rejected, or a remark on an approval).
  decisionNote String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([employeeId])
  @@index([organizationId, status])
  @@index([organizationId, createdAt])
  @@map("comp_offs")
}

enum SalaryComponentType {
  EARNING
  DEDUCTION
}

enum CalcType {
  FIXED
  PERCENTAGE
  FORMULA
  MANUAL
}

enum StatutoryKey {
  PF
  ESI
  PT
  LWF
  NPS
  GRATUITY
  BONUS
  INCOME_TAX
  EMPLOYER_INSURANCE
}

enum PayFrequency {
  MONTHLY
  QUARTERLY
  HALF_YEARLY
  YEARLY
}

model SalaryComponent {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  name String
  // Stable machine key referenced by other components' formulas/
  // percentageOf — immutable after creation (stripped from update payloads
  // in the service layer, same as the old controller).
  code String

  type     SalaryComponentType
  calcType CalcType            @default(FIXED)

  percentageOf    String? // another component's code, when calcType=PERCENTAGE
  percentageValue Float? // 0-100, when calcType=PERCENTAGE
  formula         String? // grammar in formula-engine.ts, when calcType=FORMULA
  defaultValue    Float   @default(0) // company-wide default when calcType=FIXED

  isTaxable              Boolean       @default(true)
  includeInGross         Boolean       @default(true)
  includeInNet           Boolean       @default(true)
  includeInCTC           Boolean       @default(true)
  isEmployerContribution Boolean       @default(false)
  showOnPayslip          Boolean       @default(true)
  isStatutory            Boolean       @default(false)
  statutoryKey           StatutoryKey?
  payFrequency           PayFrequency  @default(MONTHLY)

  displayOrder    Int     @default(0)
  isActive        Boolean @default(true)
  isSystemDefault Boolean @default(false)

  createdById String?
  createdBy   User?   @relation(fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employeeSalaryComponents EmployeeSalaryComponent[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@map("salary_components")
}

// Single row per organization (find-or-create-on-read singleton, matching
// the old system's PayrollSettings pattern) rather than a normal CRUD
// table — organizationId is @unique, not just indexed.
model PayrollSettings {
  id             String       @id @default(uuid())
  organizationId String       @unique
  organization   Organization @relation(fields: [organizationId], references: [id])

  financialYearStartMonth Int    @default(4)
  // 0 = last working day of month; 1-31 = fixed calendar day (clamped to
  // month length).
  processingDay           Int    @default(0)
  paymentDay              Int    @default(0)
  currency                String @default("INR")
  currencySymbol          String @default("₹")
  roundingRule            String @default("nearest") // nearest|up|down|none
  roundingDecimals        Int    @default(0)

  pfEnabled                Boolean @default(false)
  esiEnabled               Boolean @default(false)
  ptEnabled                Boolean @default(false)
  lwfEnabled               Boolean @default(false)
  npsEnabled               Boolean @default(false)
  gratuityEnabled          Boolean @default(false)
  bonusEnabled             Boolean @default(false)
  incomeTaxEnabled         Boolean @default(true)
  employerInsuranceEnabled Boolean @default(false)

  pfEmployeeRate  Float @default(12)
  pfEmployerRate  Float @default(12)
  pfWageCeiling   Float @default(15000)
  esiEmployeeRate Float @default(0.75)
  esiEmployerRate Float @default(3.25)
  esiWageCeiling  Float @default(21000)
  // Default mirrors the old system's DEFAULT_PT_SLABS exactly.
  ptSlabs         Json  @default("[{\"upTo\":7500,\"amount\":0},{\"upTo\":10000,\"amount\":175},{\"upTo\":null,\"amount\":200}]")

  lwfEmployeeAmount Float @default(25)
  lwfEmployerAmount Float @default(75)
  npsEmployerRate   Float @default(10)
  gratuityRate      Float @default(4.81)
  compOffExpiryDays Int   @default(90)

  // Overtime pay multipliers by type — applied when an overtime record is
  // logged or auto-suggested (stored on the record, so changing these only
  // affects new records). Defaults are the previously hardcoded rates.
  otRegularRate Float @default(2)
  otHolidayRate Float @default(2)
  otWeekendRate Float @default(2)
  otNightRate   Float @default(2)

  // How weekend/holiday work is compensated: { defaultKey: string|null, options: [{ key, label, compOffDays, payDays }] }.
  // Empty options = the built-in set (see overtime/work-compensation.ts). A null defaultKey keeps the hourly rate
  // unless the reviewer picks an option when approving.
  workCompensation Json @default("{}")

  // When on, variable (non-monthly) pay is also scaled by the company's
  // achievement % for the financial year (CompanyPerformance) and HELD until
  // HR/Admin enters it. Off by default so existing orgs pay as before.
  companyPerformanceEnabled Boolean @default(false)

  // Which tax declarations drive TDS. Off: a SUBMITTED declaration is used as declared (proofs reviewed later) and a
  // DRAFT is ignored. On: only VERIFIED declarations (HR has checked the proofs) change the tax — until then the
  // employee is taxed under the default regime with no declared deductions.
  taxDeclarationRequiresVerification Boolean @default(false)

  // Tax regime. Employees may switch regime themselves once a financial year (HR/Admin can always change it): on by
  // default, and `taxRegimeCutoffMonth` is the last calendar month of the year in which they may (null = until the
  // year ends). The regime an employee has chosen drives TDS from the first payroll; proofs only gate the deductions.
  taxRegimeEmployeeChange Boolean @default(true)
  taxRegimeCutoffMonth    Int?

  // Section 206AA: when on, an employee with no valid PAN is withheld at the higher of the normal TDS and 20% of
  // the month's taxable pay. Off by default — whether it applies to salary is the employer's CA's call.
  higherTdsWithoutPan Boolean @default(false)

  // Final settlement: when the tax withheld through the year (on a full-year projection) exceeds the tax on the income
  // actually earned, give the excess back in the settlement (section 192(3) lets the employer adjust within the year)
  // instead of leaving the employee to claim it through the income-tax return. On by default.
  refundExcessTdsOnExit Boolean @default(true)

  // SBI benchmark lending rate (%) used to value the perquisite of a concessional employer loan: outstanding balance
  // x (benchmark - loan rate) / 12 each month is added to taxable income (not to pay). 0 = off.
  perquisiteLoanBenchmarkRate Float @default(0)

  updatedById String?
  updatedBy   User?   @relation(fields: [updatedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("payroll_settings")
}

enum AmountBasis {
  MONTHLY
  ANNUAL
}

model EmployeeSalaryComponent {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  employeeId String
  employee   User   @relation("EmployeeSalaryComponentEmployee", fields: [employeeId], references: [id])

  // Old system's SalaryComponent FK had `constraints: false` (no DB FK) —
  // safe to make a real Prisma FK here since the controller's synthesized
  // read-only rows (see salary-structure-math.ts) are response-only and
  // never persisted.
  componentId   String
  component     SalaryComponent @relation(fields: [componentId], references: [id])
  // Denormalized copy of SalaryComponent.code — fast formula-engine
  // lookups without a join, matches the old system exactly.
  componentCode String

  // Reuses SalaryComponent's CalcType enum — same four values
  // (FIXED/PERCENTAGE/FORMULA/MANUAL), no reason to duplicate it.
  valueType       CalcType    @default(FIXED)
  fixedAmount     Float?
  percentageValue Float?
  percentageOf    String?
  formula         String?
  amountBasis     AmountBasis @default(MONTHLY)

  isEnabled Boolean @default(true)

  // YYYY-MM-DD, same plain-string convention as Holiday.date/Leave dates.
  // Revision history: effectiveTo IS NULL means this is the CURRENT row.
  // Editing NEVER mutates value fields in place — it closes the current
  // row (sets effectiveTo) and inserts a brand new one. Only effectiveTo
  // is ever updated on an existing row.
  effectiveFrom String
  effectiveTo   String?
  revisionNote  String  @default("")

  createdById String?
  createdBy   User?   @relation("EmployeeSalaryComponentCreatedBy", fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId, employeeId, componentCode, effectiveFrom])
  @@map("employee_salary_components")
}

// Year-to-date figures for a company that starts payroll partway through a financial year: what the employee earned
// and what was deducted in the months BEFORE the first run here. The tax engine adds them to the runs it holds, so the
// annual income is the whole year, not just the months paid by this system.
model EmployeeOpeningBalance {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  employeeId String
  employee   User   @relation("OpeningBalanceEmployee", fields: [employeeId], references: [id])

  financialYear   String // "2026-27"
  monthsCovered   Int // months of this FY already paid elsewhere (Apr..go-live month - 1)
  taxableEarnings Float  @default(0)
  tdsDeducted     Float  @default(0)
  pfPaid          Float  @default(0)
  ptPaid          Float  @default(0)

  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([employeeId, financialYear])
  @@index([organizationId, financialYear])
  @@map("employee_opening_balances")
}

enum HeaderStyle {
  CLASSIC
  MODERN
  MINIMAL
}

enum PayslipFontFamily {
  HELVETICA
  TIMES_ROMAN
  COURIER
  // Custom-embedded (not PDFKit standard fonts) — see payslip-pdf.service.ts's
  // registerCustomFonts()/assets/fonts/.
  ROBOTO
  MERRIWEATHER
  ROBOTO_MONO
}

// Pure payslip-PDF branding/layout config — NOT linked to SalaryComponent
// or any employee (confirmed: old system has zero per-employee/per-
// department template assignment). Single-default-per-org, enforced in
// the service layer (unset others whenever one is set).
model PayrollTemplate {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  name      String  @default("Default Template")
  isDefault Boolean @default(false)

  companyLogoUrl       String?
  // A neutral placeholder, not the vendor's own name — a template row
  // created with no companyName (the DTO field is optional) would
  // otherwise silently print this platform's own identity on another
  // org's real payslips.
  companyName          String  @default("Your Company Name")
  companyAddress       String?
  companyEmail         String?
  companyWebsite       String?
  companyContactNumber String?

  primaryColor   String @default("#5546e0")
  secondaryColor String @default("#14161d")
  accentColor    String @default("#10b981")

  footerText           String?
  signatoryName        String?
  signatoryDesignation String?
  watermarkText        String?

  headerStyle HeaderStyle       @default(MODERN)
  headerColor String? // falls back to primaryColor when unset (read-side, Payroll core)
  fontFamily  PayslipFontFamily @default(HELVETICA)
  fontSize    Int               @default(9)

  showCompanyAddress        Boolean @default(true)
  showPAN                   Boolean @default(true)
  showUAN                   Boolean @default(true)
  showESIC                  Boolean @default(true)
  showPFNumber              Boolean @default(true)
  showBankDetails           Boolean @default(true)
  showEmployerContributions Boolean @default(true)
  showCTC                   Boolean @default(true)
  showYTD                   Boolean @default(true)
  showQRCode                Boolean @default(true)
  showFooter                Boolean @default(true)

  createdById String?
  createdBy   User?   @relation(fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@map("payroll_templates")
}

enum StatutoryModule {
  PF
  ESI
  PT
  LWF
  GRATUITY
  BONUS
  NPS
  PAYROLL_CALENDAR
  ROUNDING
}

// One row = one complete, atomic, effective-dated snapshot of a single
// statutory module's config (not field-level versioning) — same
// close-current-open-row-then-insert-new pattern as
// EmployeeSalaryComponent revisions (Batch 5b).
model StatutoryConfigVersion {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  module        StatutoryModule
  // YYYY-MM-DD, same plain-string convention as every other revisioned
  // model in this codebase.
  effectiveFrom String
  effectiveTo   String?
  // Shape validated per-module in statutory-config-validation.ts.
  config        Json            @default("{}")
  isEnabled     Boolean         @default(false)
  notes         String          @default("")

  createdById String?
  createdBy   User?   @relation(fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId, module, effectiveFrom])
  @@map("statutory_config_versions")
}

enum TaxRegime {
  OLD
  NEW
}

enum TaxDeclarationStatus {
  DRAFT
  SUBMITTED
  VERIFIED
}

model EmployeeTaxDeclaration {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  employeeId    String
  employee      User      @relation(fields: [employeeId], references: [id])
  financialYear String
  regimeChosen  TaxRegime @default(NEW)

  section80C             Float   @default(0)
  section80CCD1B         Float   @default(0)
  section80CCD2          Float   @default(0)
  section80D             Float   @default(0)
  section80E             Float   @default(0)
  section80G             Float   @default(0)
  otherDeductions        Float   @default(0)
  hraRentPaidAnnual      Float   @default(0)
  isMetroCity            Boolean @default(false)
  // City of residence for the HRA limit; isMetroCity is derived from it (see common/hra-cities.ts). Empty on
  // declarations saved before the city was asked for.
  hraCity                String  @default("")
  ltaClaimed             Float   @default(0)
  previousEmployerIncome Float   @default(0)
  // Credited against the annual liability in tax-engine.ts alongside this
  // employer's YTD TDS. previousEmployerIncome without this was a systematic
  // over-deduction for mid-year joiners.
  previousEmployerTDS    Float   @default(0)
  otherIncome            Float   @default(0)
  // Section 24(b): interest on a home loan (self-occupied property, old regime, capped at 2,00,000).
  homeLoanInterest       Float   @default(0)
  // Section 80TTA: interest on savings accounts (old regime, capped at 10,000).
  section80TTA           Float   @default(0)
  // Section 89 relief for arrears/advance salary — computed by HR from the employee's Form 10E and entered by
  // HR/Admin only (an employee cannot set it). Reduces the annual tax in either regime.
  section89Relief        Float   @default(0)

  // How many times the employee changed regime after payroll had started using it this year (the limit is one), and
  // when. Choices made before the first payroll of the year are free and are not counted.
  regimeChangeCount Int       @default(0)
  regimeChangedAt   DateTime?

  status TaxDeclarationStatus @default(DRAFT)

  // Investment proofs the employee uploaded for HR to check before verifying: [{ section, fileUrl, fileName,
  // uploadedAt }]. fileUrl is the stored file key (signed on read). Editable until the declaration is VERIFIED.
  proofs Json @default("[]")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, employeeId, financialYear])
  @@index([organizationId])
  @@map("employee_tax_declarations")
}

model TaxSlabConfig {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  financialYear      String
  regime             TaxRegime
  // {from, to, rate}[] — to:null = "and above".
  slabs              Json      @default("[]")
  standardDeduction  Float     @default(75000)
  cessRate           Float     @default(4)
  // {from, to, rate}[] — surcharge on TAX amount, not income.
  surchargeSlabs     Json      @default("[]")
  rebate87ALimit     Float     @default(1200000)
  rebate87AAmount    Float     @default(60000)
  isActive           Boolean   @default(true)
  // Set when payroll created this year's slabs by copying an earlier year's (a new financial year starts with none).
  // Cleared when someone saves the slabs, i.e. has reviewed them against the Budget.
  isCarriedForward   Boolean   @default(false)
  carriedForwardFrom String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, financialYear, regime])
  @@map("tax_slab_configs")
}

enum RegularizationRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

// One row per regularization request an employee submits for a day. Attendance.regularization (JSON) still holds the
// request currently in force for the day; this table keeps every attempt, so a resubmission after a rejection, or after
// the employee withdrew one, does not erase the earlier one.
model AttendanceRegularizationRequest {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  attendanceId String
  attendance   Attendance @relation(fields: [attendanceId], references: [id], onDelete: Cascade)

  employeeId String
  employee   User   @relation("RegularizationRequestEmployee", fields: [employeeId], references: [id])

  // The attendance day the request is about (YYYY-MM-DD).
  date             String
  reason           String
  requestedInTime  DateTime?
  requestedOutTime DateTime?
  // Optional supporting document: the relativeKey from POST /files/upload/documents (signed fresh on every read).
  evidenceUrl      String?

  status         RegularizationRequestStatus @default(PENDING)
  // Decided by the 'no action in X hours' sweep rather than by a person.
  autoApproved   Boolean                     @default(false)
  reviewedById   String?
  reviewedAt     DateTime?
  reviewComments String                      @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId, employeeId, date])
  @@index([attendanceId, createdAt])
  @@map("attendance_regularization_requests")
}

enum PunchSource {
  FACE_API
  EXCEL_IMPORT
  MANUAL
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  HALF_DAY
  HOLIDAY
  WEEKLY_OFF
  ON_LEAVE
  // A real punch-in with no punch-out once the shift has ended — not enough data to call it
  // Present/Half-Day/Absent, so it's surfaced distinctly instead of silently defaulting to
  // Absent. Resolves to a final status once the employee/HR submits a regularization request.
  INCOMPLETE
}

enum WorkArrangement {
  OFFICE
  WFH
  HYBRID
  CLIENT_SITE
}

// Only meaningful when Attendance.workArrangement is WFH — every other
// arrangement stays NONE since it doesn't touch geo-fence enforcement.
// WFH starts PENDING on request and only reaches APPROVED via manager/HR
// review (see AttendanceService.reviewWorkArrangement); the fence-skip in
// selfPunch requires APPROVED specifically, not just workArrangement=WFH,
// so a self-declared WFH day can't bypass the fence unreviewed.
enum WfhApprovalStatus {
  NONE
  PENDING
  APPROVED
  REJECTED
}

enum AttendanceSource {
  FACE_API
  EXCEL_IMPORT
  REGULARIZED
  SYSTEM
}

// Immutable raw punch — one row per tap (Face API device, HR manual entry,
// or a self-punch from the mobile app). Attendance rows are derived from
// these by AttendanceService.recalculateAttendanceForDay, never written
// to directly by a punch endpoint.
model Punch {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  employeeId String
  employee   User   @relation(fields: [employeeId], references: [id])

  punchTime         DateTime
  source            PunchSource @default(FACE_API)
  location          String?
  latitude          Float?
  longitude         Float?
  // Client-supplied URL — no upload endpoint exists in backend-v2 yet, same
  // deferral as PayrollTemplate.companyLogoUrl/Leave.attachmentUrl.
  selfieUrl         String?
  // The photo as taken, kept when selfieUrl is the server-stamped copy (time, place, battery written on it).
  selfieOriginalUrl String?
  // The phone's battery level at punch time, 0-100, as the device reported it. Context only: the device supplies it.
  batteryPercent    Int?
  // Raw Face API webhook payload, kept for audit.
  rawPayload        Json?

  createdAt DateTime @default(now())

  @@index([organizationId, employeeId, punchTime])
  @@map("punches")
}

// One row per employee per day, derived/recomputed from that day's Punch
// rows by recalculateAttendanceForDay. Never blind-overwritten — writers
// only touch the specific fields they own so e.g. a pending
// `regularization` request survives a later punch-triggered recalculation.
model Attendance {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  employeeId String
  employee   User   @relation(fields: [employeeId], references: [id])

  // Point-in-time snapshot of the employee's department when this row was
  // first created — department-scoped reports previously always resolved
  // department live via the employee's *current* departmentId, so a
  // mid-month transfer silently re-attributed every one of that
  // employee's past attendance rows to the new department in any
  // department-filtered view. Null on rows created before this column
  // existed (backfilled once to the employee's department at migration
  // time, an approximation for old data) and on any row whose employee
  // has never had a department. Never overwritten once set — see
  // recalculateAttendanceForDay's read-merge-write, which only sets this
  // on first creation of a given (employeeId, date) row.
  departmentId String?

  // YYYY-MM-DD, same plain-string convention as Holiday.date/Leave dates.
  date String

  inTime              DateTime?
  outTime             DateTime?
  checkinLocation     String?
  checkinLatitude     Float?
  checkinLongitude    Float?
  checkinSelfieUrl    String?
  checkoutLocation    String?
  checkoutLatitude    Float?
  checkoutLongitude   Float?
  checkoutSelfieUrl   String?
  workDurationMinutes Int       @default(0)

  status                        AttendanceStatus  @default(ABSENT)
  // Independent of status — a WFH day is still `status: PRESENT` via the
  // normal punch flow. Only offered as a choice when Organization.enableWFH
  // is true, but the column always accepts it regardless.
  // What this day was before an approved leave stamped it (status and source), so cancelling the leave can put the
  // day back exactly as it was instead of leaving it as 'on leave'. Null on a day the leave created.
  leaveOverriddenStatus         AttendanceStatus?
  leaveOverriddenSource         AttendanceSource?
  workArrangement               WorkArrangement   @default(OFFICE)
  // See WfhApprovalStatus's comment — PENDING on WFH request, APPROVED/
  // REJECTED after review, NONE for non-WFH arrangements.
  workArrangementStatus         WfhApprovalStatus @default(NONE)
  workArrangementReviewedById   String?
  workArrangementReviewedAt     DateTime?
  workArrangementReviewComments String?
  // Rows requested together as one multi-day Work From Home request share this id (see wfh-request-days.ts).
  wfhRequestId                  String?
  isLate                        Boolean           @default(false)
  isEarlyOut                    Boolean           @default(false)
  // Reflects how this row was last derived, not any individual punch's own
  // source — recalculation always stamps FACE_API regardless of which
  // punch source triggered it.
  source                        AttendanceSource  @default(FACE_API)

  // Mirrors the old Mongo subdocument shape verbatim — not a separate
  // model, same reasoning as every other JSON-blob port in this codebase.
  // {requested, reason, requestedInTime, requestedOutTime, status
  // ('none'|'pending'|'approved'|'rejected'), reviewedBy, reviewedAt,
  // reviewComments}
  regularization Json @default("{\"requested\":false,\"reason\":\"\",\"requestedInTime\":null,\"requestedOutTime\":null,\"status\":\"none\",\"reviewedBy\":null,\"reviewedAt\":null,\"reviewComments\":\"\"}")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  regularizationRequests AttendanceRegularizationRequest[]

  @@unique([organizationId, employeeId, date])
  @@index([organizationId, date])
  @@index([organizationId, wfhRequestId])
  @@map("attendances")
}

enum ImportBatchStatus {
  PENDING_VALIDATION
  VALIDATED
  REJECTED
  EXECUTED
  // Claimed by executeImportBatch (VALIDATED -> EXECUTING compare-and-swap)
  // while it writes to the ledger, so a concurrent execute can't run twice.
  EXECUTING
  // Execution threw unexpectedly; rows written before the failure remain.
  FAILED
}

// Staging table for the two-stage Excel import (upload -> validate ->
// execute/reject) — nothing touches the live Attendance ledger until the
// execute step.
model AttendanceImportBatch {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  uploadedById String
  uploadedBy   User        @relation("AttendanceImportUploadedBy", fields: [uploadedById], references: [id])
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])
  fileName     String      @default("")

  // {employeeId, date, inTime, outTime, inLocation?, outLocation?}[] — raw
  // parsed spreadsheet rows, untyped client input same as
  // BulkImportHolidaysDto's row shape.
  rows      Json   @default("[]")
  // How a bare time in the rows (no Z / offset) is read: "UTC" (the original behaviour) or "ORG" (the organisation's own
  // timezone, which is what a biometric export or an HR sheet contains).
  timeBasis String @default("UTC")

  status           ImportBatchStatus @default(PENDING_VALIDATION)
  // {row, error}[]
  validationErrors Json              @default("[]")

  validatedById String?
  validatedBy   User?     @relation("AttendanceImportValidatedBy", fields: [validatedById], references: [id])
  validatedAt   DateTime?

  executedById    String?
  executedBy      User?     @relation("AttendanceImportExecutedBy", fields: [executedById], references: [id])
  executedAt      DateTime?
  // {imported, skipped, errors}
  executionResult Json      @default("{\"imported\":0,\"skipped\":0,\"errors\":0}")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@map("attendance_import_batches")
}

enum OvertimeType {
  REGULAR
  HOLIDAY
  WEEKEND
  NIGHT
}

enum OvertimeStatus {
  PENDING
  APPROVED
  REJECTED
}

// SELF = employee logged it themselves (OvertimeService.log). AUTO_PUNCH =
// system-suggested from a punch-out that landed past the resolved shift end
// (AttendanceService.recalculateAttendanceForDay) — still PENDING, still
// goes through the same review() approval gate as a self-logged entry;
// this only marks *how the record originated*, never auto-approves it.
enum OvertimeSource {
  SELF
  AUTO_PUNCH
  // Suggested from an Excel attendance import (the day was worked on a weekly off / holiday, or past shift end).
  IMPORT
}

// One row per employee/day/overtime-entry — not unique-constrained on date,
// an employee can log multiple entries the same day (e.g. different types).
model OvertimeRecord {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  employeeId String
  employee   User   @relation("OvertimeEmployee", fields: [employeeId], references: [id])

  // YYYY-MM-DD, same plain-string convention as every other date field.
  date           String
  hours          Float
  type           OvertimeType @default(REGULAR)
  // Derived server-side from `type` in OvertimeService.log — never
  // client-supplied.
  rateMultiplier Float        @default(1.5)

  status       OvertimeStatus @default(PENDING)
  approvedById String?
  approvedBy   User?          @relation("OvertimeApprovedBy", fields: [approvedById], references: [id])
  source       OvertimeSource @default(SELF)

  // How a weekend/holiday record was compensated when it was approved (PayrollSettings.workCompensation option). Null =
  // the hourly rate (hours x multiplier). Otherwise payDays whole days of pay go to payroll (OT_DAY_PAY_DAYS) and
  // compOffDays days of comp-off were added to the leave balance (compOffId).
  compensationKey String?
  payDays         Float   @default(0)
  compOffDays     Float   @default(0)
  compOffId       String?
  // The reviewer's note on the decision (why it was rejected, or a remark on an approval).
  decisionNote    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // One overtime record per employee/day regardless of source — without
  // this, OvertimeService.log() and AttendanceService's own auto-suggestion
  // (source=AUTO_PUNCH) could both create a row for the same day, both get
  // approved independently, and double-pay the same overshoot in payroll's
  // monthly OT sum. The service layer also pre-checks before creating (for
  // a friendly error instead of a raw conflict), but this is what actually
  // closes the race.
  @@unique([organizationId, employeeId, date])
  @@map("overtime_records")
}

// One row per (employee, financialYear) — upsert semantics, not an
// append-only log. Drives Variable-Pay payout scaling in Payroll core
// (not built yet) — this batch only builds the CRUD surface.
model PerformanceRating {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  employeeId    String
  employee      User   @relation("PerformanceRatingEmployee", fields: [employeeId], references: [id])
  financialYear String

  rating           Int
  payoutPercentage Float  @default(100)
  notes            String @default("")

  ratedById String?
  ratedBy   User?   @relation("PerformanceRatingRatedBy", fields: [ratedById], references: [id])

  status PerformanceRatingStatus @default(SUBMITTED)

  approvedById String?
  approvedBy   User?     @relation("PerformanceRatingApprovedBy", fields: [approvedById], references: [id])
  approvedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, employeeId, financialYear])
  @@index([organizationId])
  @@map("performance_ratings")
}

enum PerformanceRatingStatus {
  SUBMITTED
  APPROVED
  REJECTED
}

enum LeaveGrantStatus {
  ACTIVE
  REVERSED
}

// An entitlement HR/Admin granted to one employee for one qualifying event of an EVENT_BASED leave type. The days are
// credited to that year's LeaveBalance; a correction is a reversal (status REVERSED + who/why), never a delete.
model LeaveGrant {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  employeeId  String
  employee    User      @relation("LeaveGrantEmployee", fields: [employeeId], references: [id])
  leaveTypeId String
  leaveType   LeaveType @relation(fields: [leaveTypeId], references: [id])

  // YYYY-MM-DD, same plain-string convention as Holiday.date.
  eventDate      String
  effectiveDate  String
  days           Float
  // The balance year the days were credited to (year of effectiveDate).
  balanceYear    Int
  reason         String
  // Reference/confirmation of the supporting document or eligibility check, when the leave type requires one.
  documentRef    String?
  // Client-supplied key making a retried request return the original grant instead of granting twice.
  idempotencyKey String?

  status         LeaveGrantStatus @default(ACTIVE)
  grantedById    String
  grantedBy      User             @relation("LeaveGrantGrantedBy", fields: [grantedById], references: [id])
  reversedAt     DateTime?
  reversedById   String?
  reversedBy     User?            @relation("LeaveGrantReversedBy", fields: [reversedById], references: [id])
  reversalReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, idempotencyKey])
  @@index([organizationId, employeeId, leaveTypeId])
  @@map("leave_grants")
}

enum LeaveGrantRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

// An employee's request for an event-based leave grant. HR/Admin approve it (which creates the LeaveGrant through the
// same checks as a manual grant) or reject it; it never touches a balance by itself.
model LeaveGrantRequest {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  employeeId  String
  employee    User      @relation("LeaveGrantRequestEmployee", fields: [employeeId], references: [id])
  leaveTypeId String
  leaveType   LeaveType @relation(fields: [leaveTypeId], references: [id])

  // YYYY-MM-DD, same plain-string convention as Holiday.date.
  eventDate   String
  days        Float
  reason      String
  documentRef String?

  status       LeaveGrantRequestStatus @default(PENDING)
  decidedById  String?
  decidedBy    User?                   @relation("LeaveGrantRequestDecidedBy", fields: [decidedById], references: [id])
  decidedAt    DateTime?
  decisionNote String?
  // The grant an approval created.
  grantId      String?

  // Two-level leave types: the reporting manager's sign-off, recorded before HR/Admin give the final decision.
  level1ApprovedById String?
  level1ApprovedAt   DateTime?
  level1Comments     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId, status])
  @@index([organizationId, employeeId])
  @@map("leave_grant_requests")
}

enum LeaveEncashmentStatus {
  PENDING
  APPROVED
  PROCESSED
}

model LeaveEncashment {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  employeeId  String
  employee    User       @relation("LeaveEncashmentEmployee", fields: [employeeId], references: [id])
  leaveTypeId String?
  leaveType   LeaveType? @relation(fields: [leaveTypeId], references: [id])

  days          Float
  ratePerDay    Float
  amount        Float
  // e.g. "2026-27" — resolved from PayrollSettings.financialYearStartMonth
  // at request time via getFinancialYear.
  financialYear String

  status       LeaveEncashmentStatus @default(PENDING)
  approvedById String?
  approvedBy   User?                 @relation("LeaveEncashmentApprovedBy", fields: [approvedById], references: [id])

  // Stamped once the PayrollRun that pays this out is locked — Payroll
  // core, not built yet.
  payrollRunId  String?
  // FnF settlement linkage — Settlement module, well after Payroll core.
  settlementRef String?
  processedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId, employeeId])
  @@index([organizationId, status])
  @@index([organizationId, createdAt])
  @@map("leave_encashments")
}

// The figures of a finalised payroll run as they were when it was unlocked for correction, so the original result
// (what was paid, on which payslip) stays reproducible after the run is recalculated. Written once, never updated.
// Self-contained on purpose (no foreign key to the run): the history must outlive anything that happens to the run.
model PayrollRunRevision {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  payrollRunId   String
  employeeId     String
  month          Int
  year           Int
  runSequence    Int              @default(0)
  // 0 = the first finalised version; the run's own revisionNumber moves up by one when this row is written.
  revision       Int
  previousStatus PayrollRunStatus
  reason         String
  createdById    String
  createdAt      DateTime         @default(now())
  snapshot       Json

  @@unique([payrollRunId, revision])
  @@index([organizationId, payrollRunId])
  @@map("payroll_run_revisions")
}

enum PayrollRunStatus {
  DRAFT
  CALCULATED
  VERIFIED
  APPROVED
  LOCKED
  PAID
}

model PayrollRun {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  // The company brand (sister-company name and logo) the employee had when this run was calculated; the payslip shows it. Kept while the
  // run is editable and frozen once locked, so an old payslip never changes when someone later moves company. Null = the organization's own.
  brandId String?

  employeeId String
  employee   User   @relation("PayrollRunEmployee", fields: [employeeId], references: [id])

  month           Int
  year            Int
  financialYear   String?
  status          PayrollRunStatus @default(DRAFT)
  // Set when attendance, leave or overtime changes after this run was calculated, so its figures no longer match the
  // records; cleared by the next calculation. A run with this set cannot be verified, approved or locked.
  inputsChangedAt DateTime?
  // How many times this run has been unlocked and corrected; the figures as finalised before each correction are kept in
  // PayrollRunRevision. 0 = the original, never reopened.
  revisionNumber  Int              @default(0)

  // {workingDays, presentDays, paidLeaveDays, unpaidLeaveDays, halfDays,
  // overtimeHours, lateMarks, holidayWorkDays, weekendWorkDays, lopDays,
  // payableDays, totalDaysInMonth, holidays, weeklyOffs}
  attendanceSummary     Json  @default("{}")
  // {code, name, amount, taxable}[]
  earnings              Json  @default("[]")
  // {code, name, amount}[]
  deductions            Json  @default("[]")
  // {code, name, amount}[]
  employerContributions Json  @default("[]")
  // Full taxDetails shape from taxEngine.calculateTax (see tax-engine.ts).
  taxDetails            Json?
  // Variable-pay components not paid in this run because the company
  // performance % for their financial year isn't entered yet:
  // [{ code, name, cycleKey: "2027-03", financialYear }]. A later run pays
  // them once it exists (see PayrollService.calculatePayroll).
  heldVariablePay       Json  @default("[]")

  grossSalary                Float  @default(0)
  // Sum of the taxable earning lines — the month's income-tax base, summed
  // for YTD taxable income. Null on runs saved before it existed (YTD then
  // re-derives it from the stored lines' `taxable` flags, else grossSalary).
  taxableGross               Float?
  totalDeductions            Float  @default(0)
  totalEmployerContributions Float  @default(0)
  netPay                     Float  @default(0)
  ctcMonthly                 Float  @default(0)
  netPayInWords              String @default("")

  // Issued once, the first time this run is calculated, from the org's
  // documentNumbering.payslip config (see issueDocumentNumber) — stays
  // fixed across recalculation so re-running a payroll before it's
  // locked doesn't burn a new number each time. Null until first
  // calculated.
  payslipNumber String?

  calculatedAt   DateTime?
  calculatedById String?
  calculatedBy   User?     @relation("PayrollRunCalculatedBy", fields: [calculatedById], references: [id])
  verifiedAt     DateTime?
  verifiedById   String?
  approvedAt     DateTime?
  approvedById   String?
  lockedAt       DateTime?
  lockedById     String?
  paidAt         DateTime?
  paidById       String?
  unlockedAt     DateTime?
  unlockedById   String?
  unlockReason   String?

  // Idempotency marker for PayslipEmailWorker — checked before building/
  // sending, so a retried or duplicate-delivered BullMQ job for the same
  // run doesn't resend an already-delivered payslip email.
  payslipEmailSentAt DateTime?

  // Dead field carried for schema fidelity, same as the old model — no
  // upload endpoint writes this yet.
  payslipUrl           String      @default("")
  // FnF settlement runs — created by SettlementsService.process, always
  // false for a regular monthly run.
  isFinalSettlement    Boolean     @default(false)
  settlement           Settlement?
  // 0 = the month's regular run. 1, 2, ... = supplementary (off-cycle) runs for the same employee and month — a bonus,
  // incentive, arrears or correction paid outside the regular run, created by PayrollService.createSupplementary.
  runSequence          Int         @default(0)
  // Free-text name for a supplementary run ("Diwali bonus", "Arrears Apr-Jun"); null on regular and F&F runs.
  runLabel             String?
  // Supplementary arrears runs: [{ month, year, amount }] - the locked/paid months this payment makes good, so the same
  // difference is never paid twice.
  arrearsDetail        Json?
  // Payment tracking, recorded after the bank transfer: mode (NEFT/RTGS/IMPS/UPI/CHEQUE/CASH/OTHER), the bank UTR or
  // cheque number and the date the money moved.
  paymentMode          String?
  paymentReference     String?
  paymentDate          String?
  // Salary on hold: the run is calculated and signed off as usual but is not paid (and stays out of the bank file) until
  // the hold is released - e.g. a new joiner's pay that should roll into next month, or an unreturned asset.
  heldAt               DateTime?
  heldById             String?
  holdReason           String?
  // Set once a lock's side effects (loan EMIs charged, leave encashments processed) have been applied. A LOCKED/PAID
  // run where this is null had its process die between the status change and the side effects - see
  // PayrollService.lockEffectsPending / reapplyLockEffects.
  lockEffectsAppliedAt DateTime?

  // Point-in-time snapshot taken at calculation so a re-issued payslip keeps the designation/department/
  // grade the employee held that month. Nullable: older runs fall back to the live values.
  designation    String?
  departmentName String?
  gradeLevel     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([employeeId, month, year, isFinalSettlement, runSequence])
  @@index([organizationId, month, year])
  @@map("payroll_runs")
}

enum ReimbursementCategory {
  TRAVEL
  FUEL
  MOBILE
  INTERNET
  MEDICAL
  OTHER
}

enum ReimbursementStatus {
  PENDING
  APPROVED
  REJECTED
  PAID
}

enum ReimbursementPaymentMode {
  CASH
  CHEQUE
  TRANSFER
}

model Reimbursement {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  employeeId String
  employee   User   @relation("ReimbursementEmployee", fields: [employeeId], references: [id])

  category    ReimbursementCategory @default(OTHER)
  amount      Float
  // YYYY-MM-DD, same plain-string convention as Leave.startDate.
  claimDate   String
  description String                @default("")
  // No file-storage infrastructure exists yet (Batch 9 deferral, same as
  // every other file field in backend-v2) — stored as a plain string, no
  // signed-URL resolution.
  receiptUrl  String                @default("")
  status      ReimbursementStatus   @default(PENDING)

  approvedById   String?
  approvedBy     User?                     @relation("ReimbursementApprovedBy", fields: [approvedById], references: [id])
  // Set alongside approvedById — kept as its own field (not read off
  // updatedAt) because a later PAID transition updates the row again and
  // would otherwise clobber the moment it was actually approved. YYYY-MM-DD.
  approvedDate   String?
  reviewComments String                    @default("")
  // Set together when HR marks an APPROVED claim PAID — a manual step,
  // independent of the PayrollRun-driven payout integration below (which
  // still isn't built). Deliberately separate from approvedDate: approval
  // can land on the last day of a month while the actual payout happens the
  // next day (or later) once cash/cheque/transfer is actually processed.
  // paidDate defaults to today if the reviewer doesn't pick one, but is a
  // free-form date so a backdated payout can be recorded accurately.
  // YYYY-MM-DD, same plain-string convention as claimDate.
  paidDate       String?
  paidById       String?
  paidBy         User?                     @relation("ReimbursementPaidBy", fields: [paidById], references: [id])
  paymentMode    ReimbursementPaymentMode?
  // Stamped once a PayrollRun pays this out — payroll deduction/payout
  // integration for reimbursements isn't built yet, same deferral as
  // LeaveEncashment.payrollRunId.
  payrollRunId   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId, employeeId])
  @@index([organizationId, status])
  @@index([organizationId, createdAt])
  @@map("reimbursements")
}

enum LoanType {
  LOAN
  ADVANCE
}

enum LoanStatus {
  // Employee-requested, awaiting HR/Admin's approve/reject decision — not
  // in the old system, which only ever let HR sanction a loan directly.
  PENDING
  REJECTED
  ACTIVE
  CLOSED
  CANCELLED
}

model Loan {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  employeeId String
  employee   User   @relation("LoanEmployee", fields: [employeeId], references: [id])

  loanType           LoanType   @default(LOAN)
  principal          Float
  // Annual %.
  interestRate       Float      @default(0)
  tenureMonths       Int
  emiAmount          Float
  startMonth         Int
  startYear          Int
  outstandingBalance Float
  status             LoanStatus @default(ACTIVE)
  reason             String     @default("")

  approvedById String?
  approvedBy   User?   @relation("LoanApprovedBy", fields: [approvedById], references: [id])

  closureReason String    @default("")
  closedAt      DateTime?
  closedById    String?
  closedBy      User?     @relation("LoanClosedBy", fields: [closedById], references: [id])

  repayments LoanRepayment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId, employeeId])
  @@index([organizationId, status])
  @@index([organizationId, createdAt])
  @@map("loans")
}

model LoanRepayment {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  loanId String
  loan   Loan   @relation(fields: [loanId], references: [id])

  // Stamped when a PayrollRun deducts this EMI — payroll integration for
  // loan repayments isn't built yet, same deferral as
  // Reimbursement.payrollRunId. This endpoint currently only supports HR
  // manually recording a repayment.
  payrollRunId String?

  month              Int
  year               Int
  amount             Float
  principalComponent Float @default(0)
  interestComponent  Float @default(0)
  balanceAfter       Float @default(0)

  createdAt DateTime @default(now())

  @@index([organizationId, loanId])
  @@map("loan_repayments")
}

enum SettlementStatus {
  DRAFT
  PROCESSED
  PAID
}

// What the employee still owes the company when the recoveries in the final settlement are more than the payout:
// the settlement pays 0 and the rest is DUE until HR records that it was collected (RECOVERED) or an Admin waives it.
enum ReceivableStatus {
  NONE
  DUE
  RECOVERED
  WAIVED
}

// Full & Final settlement — old system's FullFinalSettlement, ported under
// a shorter name since this app has no other "settlement" concept to
// disambiguate from.
model Settlement {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  employeeId String
  employee   User   @relation("SettlementEmployee", fields: [employeeId], references: [id])

  // YYYY-MM-DD, same plain-string convention as Leave.startDate.
  lastWorkingDay String

  pendingSalaryAmount    Float @default(0)
  // The LWD-month payroll snapshot pendingSalaryAmount was derived from —
  // {earnings, deductions, employerContributions} as calculated (LOAN_EMI
  // excluded, since the loan balance is recovered separately). process()
  // copies these real lines (PF/ESI/PT/TDS, employer contributions) onto the
  // final-settlement PayrollRun instead of one net PENDING_SALARY figure.
  // Null when no pending salary was due, and on drafts calculated before this
  // column existed (those fall back to the single PENDING_SALARY line).
  pendingSalaryBreakdown Json?
  // Unlike the old system (which read a dead, always-zero legacy
  // User.leaveBalance.el JSON field — never written anywhere else in that
  // codebase), this sums (closing balance × rate/day) across every
  // LeaveType with encashment.allowed=true, using the real LeaveBalance
  // table the leave-encashments module already relies on. No
  // minBalanceToRetain cap here — the employee is leaving, so the full
  // balance is paid out.
  leaveEncashmentAmount  Float @default(0)
  bonusAmount            Float @default(0)
  recoveriesAmount       Float @default(0)
  loanBalanceRecovered   Float @default(0)
  noticePeriodRecovery   Float @default(0)
  gratuityAmount         Float @default(0)
  // The part of gratuityAmount above its s.10(10) tax exemption - taxed with the final pay (0 when fully exempt).
  gratuityTaxableAmount  Float @default(0)
  // APPROVED-but-unpaid reimbursement claims settled with the final payout (marked PAID by process()).
  reimbursementAmount    Float @default(0)
  netSettlementAmount    Float @default(0)

  // The part of the recoveries (notice shortfall, advances) the payout could not cover, owed by the employee. It is
  // collected outside payroll (the next employer is never liable for it) and then closed as RECOVERED, or waived by an Admin.
  receivableAmount     Float            @default(0)
  receivableStatus     ReceivableStatus @default(NONE)
  receivableNote       String?
  receivableClosedAt   DateTime?
  receivableClosedById String?

  // Notice period: pay the employer waived (employee released before the notice ended) and the shortfall the
  // recovery above was derived from. noticePeriodRecovery is calculated from the notice days unless HR overrode it.
  noticePayAmount        Float   @default(0)
  noticeShortfallDays    Float   @default(0)
  noticeRecoveryAuto     Boolean @default(false)
  // Statutory bonus on exit: the bonus due for the accounting year up to the last working day, what was already paid
  // in the year (regular or supplementary runs), and whether bonusAmount is that difference (auto) or HR's own figure.
  // bonusDisqualified: HR recorded a disqualification (dismissal for misconduct) so none is calculated.
  statutoryBonusDue      Float   @default(0)
  statutoryBonusPaid     Float   @default(0)
  bonusAuto              Boolean @default(false)
  bonusDisqualified      Boolean @default(false)
  // Why recoveriesAmount was deducted — required whenever it is above zero.
  recoveriesReason       String?
  // Leave encashment: the part exempt under s.10(10AA) (not taxed) and the per-leave-type days behind the figure
  // [{leaveTypeId, year, days}], which process() debits from the balance and a reversal puts back.
  leaveEncashmentExempt  Float   @default(0)
  leaveEncashmentDetail  Json?
  // Active loans closed by process() [{id, outstandingBalance, status}] so a reversal can reopen them, and what could
  // not be recovered from the payout (loans left open for HR to follow up).
  closedLoans            Json?
  loanBalanceUnrecovered Float   @default(0)

  status SettlementStatus @default(DRAFT)

  // Who calculated the draft (maker); process() needs a different approver unless an Admin does both.
  calculatedById String?
  processedById  String?
  processedBy    User?   @relation("SettlementProcessedBy", fields: [processedById], references: [id])

  // Payment record, stamped by markPaid().
  paidAt           DateTime?
  paidById         String?
  paymentMode      String?
  paymentReference String?

  // Last reversal of a processed settlement back to DRAFT (history is in the audit log).
  reversedAt     DateTime?
  reversedById   String?
  reversalReason String?

  payrollRunId String?     @unique
  payrollRun   PayrollRun? @relation(fields: [payrollRunId], references: [id])

  offboardingCases OffboardingCase[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId, employeeId])
  @@index([organizationId, status])
  @@index([organizationId, createdAt])
  @@map("settlements")
}

enum OffboardingStatus {
  INITIATED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

// One row per employee exit — tracks the checklist that has to complete
// before the account is deactivated, mirroring the old system's
// OffboardingCase.
// A sister company's face inside one organization: the name, logo and address its employees' payslips, letters and emails carry, and
// optionally its own employee ID series. Everything else (payroll, leave, statutory, HR) stays shared. An employee with no brand uses
// the organization's own branding and ID series, so a company that never adds a brand is unaffected.
model CompanyBrand {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  name         String
  legalName    String?
  // Stored file keys, like Organization.companyLogoUrl / emailLogoUrl.
  logoUrl      String?
  emailLogoUrl String?
  address      String?
  contactEmail String?
  phone        String?
  website      String?

  // This brand's own employee ID series: the format is a literal prefix plus one counter token (e.g. 'SA-{00000}') and the counter
  // holds the last number issued. Null format = people in this brand take their ID from the company's series.
  employeeIdFormat  String?
  employeeIdCounter Int     @default(0)

  isActive  Boolean @default(true)
  isDefault Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users User[] @relation("UserBrand")

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("company_brands")
}


// The joining checklist of one new joiner: who owns each step (laptop, work email, ID card, team introduction...) and by when.
// Steps the system can see for itself (assets allocated, documents uploaded, profile completed) are worked out on read, not stored.
// Created automatically for people who joined recently or are about to (see JoiningChecklistService).
model JoiningChecklist {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  employeeId String
  employee   User   @relation("JoiningChecklistEmployee", fields: [employeeId], references: [id])

  // { [itemKey]: { ownerId: string | null, dueDate: 'YYYY-MM-DD' | null, doneAt: ISO string | null, doneById: string | null } }
  items Json @default("{}")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, employeeId])
  @@index([organizationId])
  @@map("joining_checklists")
}

model OffboardingCase {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  employeeId String
  employee   User   @relation("OffboardingCaseEmployee", fields: [employeeId], references: [id])

  initiatedById String
  initiatedBy   User   @relation("OffboardingCaseInitiatedBy", fields: [initiatedById], references: [id])

  // YYYY-MM-DD, same plain-string convention as Leave.startDate.
  lastWorkingDay String
  reason         String?

  status OffboardingStatus @default(INITIATED)

  // Exit checklist — each flipped independently, all required before the
  // case can be marked complete.
  assetsReturned         Boolean @default(false)
  accessRevoked          Boolean @default(false)
  // Set automatically once exitInterviewResponses is submitted (see
  // OffboardingService.submitExitInterview) — there's no path to flip it
  // true without actually answering the questions.
  exitInterviewDone      Boolean @default(false)
  exitInterviewResponses Json?

  // Set once a Settlement has been linked for this exit.
  settlementId String?
  settlement   Settlement? @relation(fields: [settlementId], references: [id])

  notes String?

  // How the exit ends: the employmentStatus complete() applies (RELEASED | TERMINATED | ABSCONDED).
  exitStatus               EmploymentStatus  @default(RELEASED)
  // The status held before initiate() moved the employee to RESIGNED, restored by cancel().
  previousEmploymentStatus EmploymentStatus?
  // HR's explicit note when completing with company assets still unreturned.
  assetOverrideNote        String?

  // Who owns each checklist item and by when: { assets: { ownerId, dueDate }, access: {...}, handover: {...}, interview: {...} }.
  // Set when the exit starts (defaults), editable by HR; drives the owner's reminders.
  checklistMeta Json @default("{}")
  // Items the system ticked by itself (e.g. no assets left allocated): { assets: true, ... }, shown as "done automatically".
  autoTicked    Json @default("{}")
  // When the final settlement draft was prepared automatically, and when the case first became ready to complete.
  fnfPreparedAt     DateTime?
  readyToCompleteAt DateTime?
  // When the relieving / experience letters were emailed on completion.
  lettersSentAt     DateTime?
  // When the leaver's pending requests were closed automatically after the last working day, and when the final-documents pack
  // (last six payslips) was emailed to their personal address.
  pendingClearedAt  DateTime?
  exitPackSentAt    DateTime?

  completedById String?
  completedBy   User?     @relation("OffboardingCaseCompletedBy", fields: [completedById], references: [id])
  completedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId, employeeId])
  @@index([organizationId, status])
  @@index([organizationId, createdAt])
  @@map("offboarding_cases")
}

enum AuditModule {
  AUTH
  EMPLOYEE
  ATTENDANCE
  LEAVE
  PAYROLL
  DEPARTMENT
  DOCUMENT
  HOLIDAY
  NOTIFICATION
  ORGANIZATION
  ASSET
}

// Records attendance changes, payroll changes, leave approvals, login
// activity, and profile edits — fire-and-forget writes from AuditLogService
// (write failures are swallowed, same as the old system's logAudit util,
// since a broken audit write should never fail the underlying action).
//
// This batch wires it into a representative sample of high-value write
// paths (login, employee deactivation, payroll lock/pay) as proof of
// integration, not a full retrofit of every mutating endpoint across the
// codebase — that's separate follow-up work given how much already exists.
model AuditLog {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  actorId String
  actor   User   @relation(fields: [actorId], references: [id])

  // e.g. 'LEAVE_APPROVED', 'PAYROLL_PROCESSED'.
  action    String
  module    AuditModule
  targetId  String?
  details   Json        @default("{}")
  ipAddress String      @default("")
  // The actor's role when it happened (their role today may differ), SUCCESS or FAILURE (a refused or denied attempt),
  // and the id of the HTTP request (also returned to the caller as X-Request-Id) for correlating with server logs.
  actorRole String?
  outcome   String      @default("SUCCESS")
  requestId String?

  createdAt DateTime @default(now())

  @@index([organizationId, module])
  @@index([organizationId, actorId])
  @@index([organizationId, module, createdAt])
  @@index([organizationId, targetId])
  @@map("audit_logs")
}

enum TimelineCategory {
  RECRUITMENT
  EMPLOYMENT
  ORGANIZATION
  PAYROLL
  ATTENDANCE_LEAVE
  PERFORMANCE
  COMPLIANCE
  EXIT
}

// Append-only log of an employee's 360° journey — every row is a fact
// about something that happened, never edited or overwritten afterward.
// Written via EmployeeTimelineService.logEvent() from the various
// services where each event actually occurs, mirroring how
// AuditLogService.log() is called — the two are deliberately fired from
// the same code paths so Timeline and Audit Log never drift apart.
model EmployeeTimeline {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  employeeId String
  employee   User   @relation("TimelineEmployee", fields: [employeeId], references: [id])

  category    TimelineCategory
  // e.g. 'DEPARTMENT_CHANGED' — see employee-timeline-events.ts EVENT_META.
  eventKey    String
  title       String
  description String?          @default("")

  occurredAt DateTime @default(now())

  // null = system-generated.
  performedById String?
  performedBy   User?   @relation("TimelinePerformedBy", fields: [performedById], references: [id])

  remarks         String? @default("")
  relatedDocument String? @default("")
  status          String? @default("")
  // Free-form event-specific context (old/new values, etc.).
  metadata        Json    @default("{}")

  createdAt DateTime @default(now())

  @@index([organizationId, employeeId, occurredAt])
  @@map("employee_timeline")
}

// Temporarily routes a manager's leave/regularization approvals to another
// MANAGER/HR/ADMIN for a date range (e.g. the manager is themself on
// leave). Checked alongside reportingManagerId in LeavesService.review()
// when resolving who can approve a given employee's request.
model ApprovalDelegation {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  delegatorId String
  delegator   User   @relation("DelegationDelegator", fields: [delegatorId], references: [id])
  delegateId  String
  delegate    User   @relation("DelegationDelegate", fields: [delegateId], references: [id])

  // YYYY-MM-DD, same plain-string convention as Leave.startDate.
  fromDate String
  toDate   String

  isActive Boolean @default(true)

  createdById String
  createdBy   User   @relation("DelegationCreatedBy", fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId, delegatorId])
  @@map("approval_delegations")
}

enum PolicyDocType {
  PDF
  IMAGE
  VIDEO
  URL
}

enum PolicyVisibility {
  EVERYONE
  HR_ONLY
  MANAGERS
  DEPARTMENTS
  EMPLOYEES
}

// Company-wide policy/document library (distinct from DocumentRequirement
// below, which is the master list of per-employee document *requirements*).
model PolicyDocument {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  title    String
  category String        @default("General")
  docType  PolicyDocType @default(PDF)

  // A relativeKey from POST /files/upload/documents (organizationId/
  // documents/uuid.ext) when we host the file, or a raw http(s):// URL when
  // docType=URL. Never a signed URL — those are minted fresh per response.
  fileUrl  String
  fileName String

  isPublished Boolean @default(true)

  // Only documents HR flags (compliance policies — Code of Conduct, POSH, IT
  // Acceptable Use, ...) ask employees to e-acknowledge; everything else is
  // view/download only. Carried over to each new version.
  requiresAcknowledgment Boolean @default(false)

  uploadedById String?
  uploadedBy   User?   @relation("PolicyDocumentUploadedBy", fields: [uploadedById], references: [id])

  visibility         PolicyVisibility @default(EVERYONE)
  visibleDepartments String[]         @default([])
  visibleEmployees   String[]         @default([])

  // New-version uploads create a new row (not an update) chained via
  // previousVersionId, and retire the old row by flipping isPublished to
  // false — version history is a linked list of rows, mirroring the old
  // system exactly.
  version           Int     @default(1)
  previousVersionId String?

  acknowledgments PolicyDocumentAcknowledgment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId, createdAt])
  @@map("policy_documents")
}

// A lightweight e-acknowledgment, not a certified digital signature — an
// employee typing their name against a specific PolicyDocument *version*
// (each version is its own row via previousVersionId, so re-publishing a
// document naturally requires re-acknowledgment; nothing here needs to
// track version numbers itself). Immutable once created — see
// DocumentsService.acknowledgePolicy's "already acknowledged" guard; this
// is a signed record, not an editable form.
model PolicyDocumentAcknowledgment {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  policyDocumentId String
  policyDocument   PolicyDocument @relation(fields: [policyDocumentId], references: [id])

  employeeId String
  employee   User   @relation(fields: [employeeId], references: [id])

  // What the employee typed as their signature at acknowledgment time —
  // captured verbatim (not necessarily identical to their profile name),
  // same as a wet-ink signature not always matching a printed name exactly.
  signatureName  String
  ipAddress      String?
  userAgent      String?
  acknowledgedAt DateTime @default(now())

  @@unique([organizationId, policyDocumentId, employeeId])
  @@index([organizationId, employeeId])
  @@map("policy_document_acknowledgments")
}

// HR/Admin-defined master list of expected employee document types (NDA,
// Police Verification, ...), on top of the app's built-in defaults. Each
// employee's actual uploaded file still lives on the Employee attachment
// endpoints — this table is only "what's expected", not the uploads
// themselves.
model DocumentRequirement {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  name String

  isMandatory     Boolean @default(false)
  // Seeded baseline requirement (PAN Card, Aadhaar Card, Passport Photo, Educational Certificate):
  // name is locked and it can't be deleted — only deactivated or marked mandatory. Same convention as
  // LeaveType/OrgListItem.isSystemDefault.
  isSystemDefault Boolean @default(false)
  // Soft-disable, not a delete — matches the old system: a disabled
  // requirement stops appearing as expected/missing but any already-
  // uploaded documents against it are untouched.
  isActive        Boolean @default(true)
  displayOrder    Int     @default(0)

  createdById String?
  createdBy   User?   @relation("DocumentRequirementCreatedBy", fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, name])
  @@map("document_requirements")
}

enum OrgListType {
  DESIGNATION
  GRADE
  EMPLOYEE_CATEGORY
  // Asset Inventory's category master (Laptop/Desktop/Monitor/...) — reuses
  // this same configurable-list mechanism rather than getting a table of its
  // own. The one difference: Asset.categoryId is a real FK here, where the
  // other three types are copied onto the Employee row as plain strings.
  ASSET_CATEGORY
  // Offboarding exit interview's "Reason for Leaving" options — seeded with
  // the previously hardcoded list, then fully editable per org.
  REASON_FOR_LEAVING
}

// Simple org-scoped named lists (Designations, Grades/Levels, Employee
// Categories) — each row's `name` is the exact string an Employee's
// designation/gradeLevel/employeeCategory field stores, no FK, matching
// how designation already worked before this list existed. Employment
// Type deliberately isn't a fourth OrgListType here — it already has its
// own mechanism (Organization.customEmployeeTypes), reused rather than
// duplicated, since business logic (employmentStatus assignment) compares
// against its exact slug values.
model OrgListItem {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  type     OrgListType
  name     String
  isActive Boolean     @default(true)

  // Built-in only for type=EMPLOYEE_CATEGORY (Full-Time/Part-Time/Contract/
  // Intern, seeded by OrgListItemsService.seedDefaults()) — Designations
  // and Grades get no such protection, there's nothing else in the app
  // that depends on a specific one of those existing. A built-in
  // category's name is locked and it can't be deleted; isActive still is.
  isSystemDefault Boolean @default(false)

  // Only ever populated for type=ASSET_CATEGORY — the Asset Inventory
  // master is the one OrgListType consumer holding a real FK back here
  // instead of copying `name` onto the consuming row as a plain string.
  assets Asset[] @relation("AssetCategory")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, type, name])
  @@index([organizationId, type])
  @@map("org_list_items")
}

enum NotificationCategory {
  LEAVE
  REGULARIZATION
  PAYROLL
  ATTENDANCE
  GENERAL
  // Defined for parity with the old system's enum, but nothing creates one
  // — no controller old-side ever fires an ONBOARDING-category
  // notification. Kept for schema fidelity, not because it's used.
  ONBOARDING
}

model Notification {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  userId String
  user   User   @relation(fields: [userId], references: [id])

  title    String
  message  String
  category NotificationCategory @default(GENERAL)
  isRead   Boolean              @default(false)
  // Defined for parity with the old model, but never populated by any
  // trigger site old-side (dead field there too) — carried over as-is.
  link     String               @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId, userId, isRead])
  @@map("notifications")
}

enum EmployeeDocumentStatus {
  PENDING
  APPROVED
  REJECTED
}

// DOCUMENT = KYC/onboarding paperwork shown on the Documents tab (against
// DocumentRequirement's master list). LETTER = a manually-uploaded letter
// (e.g. a signed scan) shown on the Letters tab alongside the
// auto-generated LetterTemplate ones — same upload/review/delete plumbing,
// just kept out of each other's list.
enum EmployeeDocumentCategory {
  DOCUMENT
  LETTER
}

// Real table, not a JSON array like the old system — lets a review action
// join back to the reviewer and gives normal list/status semantics. Files
// themselves go through the existing generic files module (POST
// /files/upload/documents) — this row only ever stores the resulting
// relativeKey, matching the "upload-then-PATCH/POST" convention already
// established for policy documents, branding assets, etc.
model EmployeeDocument {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  employeeId String
  employee   User   @relation("EmployeeDocumentEmployee", fields: [employeeId], references: [id])

  // Free string, matched loosely against a hardcoded default list
  // (PAN Card / Aadhaar Card / Passport Photo / Educational Certificate /
  // Relieving Letter or Experience Certificate / Other) and the org's own
  // DocumentRequirement master list — same as the old system.
  docType           String
  fileName          String
  fileUrl           String
  category          EmployeeDocumentCategory @default(DOCUMENT)
  // Only meaningful for an uploaded Letter (category LETTER): HR/Admin can switch it off so the employee no longer sees
  // it (the "Visible to employee" tick, as on the generated letters). Defaults to visible, as before.
  visibleToEmployee Boolean                  @default(true)

  status       EmployeeDocumentStatus @default(PENDING)
  reviewReason String?
  reviewedById String?
  reviewedBy   User?                  @relation("EmployeeDocumentReviewedBy", fields: [reviewedById], references: [id])
  reviewedAt   DateTime?

  uploadedAt DateTime @default(now())

  @@index([organizationId, employeeId])
  @@map("employee_documents")
}

enum AssetStatus {
  ALLOCATED
  RETURNED
  LOST
}

// assetType is deliberately free-text, not an enum — the old system had a
// 6-value ENUM that didn't match its own frontend's much larger dropdown
// (Laptop/Desktop/MacBook/Monitor/... 25+ options), so most real
// allocations there silently fell through to "Other". Not a behavior worth
// preserving.
model EmployeeAsset {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  employeeId String
  employee   User   @relation("EmployeeAssetEmployee", fields: [employeeId], references: [id])

  assetType String
  assetName String
  assetTag  String?

  status        AssetStatus @default(ALLOCATED)
  allocatedDate String
  returnedDate  String?
  notes         String?

  // Soft-delete flag — a "removed" asset record (e.g. entered in error, or
  // an org wants to archive an old row) stays in the table for audit-trail
  // integrity but drops out of listAssets()/getFullProfile(). Deliberately
  // separate from AssetStatus: RETURNED/LOST describe what happened to the
  // physical asset, not whether the record itself should still be visible
  // — an ALLOCATED asset can also be soft-deleted (e.g. a mistaken entry)
  // without that meaning it was returned. Same isActive convention used
  // throughout this schema (User, Department, etc.).
  isActive Boolean @default(true)

  allocatedById String
  allocatedBy   User   @relation("EmployeeAssetAllocatedBy", fields: [allocatedById], references: [id])

  // Nullable — only set once the asset is actually marked RETURNED, unlike
  // allocatedById which is always present from creation. Mirrors the
  // allocatedById/allocatedBy pattern exactly.
  returnedById String?
  returnedBy   User?   @relation("EmployeeAssetReturnedBy", fields: [returnedById], references: [id])

  // Optional link to the Asset Inventory master record this allocation is
  // for. Nullable by design: the free-text allocation flow (assetType/
  // assetName/assetTag typed by hand) predates the inventory module and
  // stays fully supported — every pre-existing row keeps assetId = null,
  // and omitting it on a new allocation behaves exactly as before. When
  // set, allocating/returning this row also flips the linked Asset's
  // status (ASSIGNED / back to AVAILABLE), which is the entire integration
  // between the two modules — assignment itself stays owned by the
  // Employees module's endpoints; the Assets module never assigns.
  assetId String?
  asset   Asset?  @relation(fields: [assetId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Scoped per-org, not global — assetTag (e.g. a serial/inventory tag) is
  // only meaningful within one org's inventory, and two different orgs may
  // legitimately reuse the same tag. NULLs are exempt from Postgres unique
  // indexes (same as other optional unique columns in this schema), so this only
  // enforces uniqueness when assetTag is actually provided.
  @@unique([organizationId, assetTag])
  @@index([organizationId, employeeId])
  @@index([assetId])
  @@map("employee_assets")
}

// Append-only audit trail of role/designation/department changes —
// written automatically inside EmployeesService.update() whenever one of
// those three fields actually changes, mirroring the old system's
// logAudit-adjacent behavior.
model EmployeeRoleHistory {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  employeeId String
  employee   User   @relation("RoleHistoryEmployee", fields: [employeeId], references: [id])

  previousRole         Role?
  newRole              Role?
  previousDesignation  String?
  newDesignation       String?
  previousDepartmentId String?
  newDepartmentId      String?

  changedById String
  changedBy   User     @relation("RoleHistoryChangedBy", fields: [changedById], references: [id])
  changedAt   DateTime @default(now())

  @@index([organizationId, employeeId])
  @@map("employee_role_history")
}

// Append-only audit trail of employmentStatus transitions.
model EmploymentStatusHistory {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  employeeId String
  employee   User   @relation("StatusHistoryEmployee", fields: [employeeId], references: [id])

  previousStatus EmploymentStatus?
  newStatus      EmploymentStatus
  note           String?

  changedById String
  changedBy   User     @relation("StatusHistoryChangedBy", fields: [changedById], references: [id])
  changedAt   DateTime @default(now())

  @@index([organizationId, employeeId])
  @@map("employment_status_history")
}

// ---------------------------------------------------------------------------
// Data Privacy & Protection (DPDP-aligned privacy controls). All tables are
// tenant-scoped (organizationId). User references (userId, actorId, ...) are
// plain ids without FKs on purpose: privacy records, and above all the
// hash-chained PrivacyAuditLog, must outlive any change to the User row.
// ---------------------------------------------------------------------------

enum ConsentStatus {
  GRANTED
  WITHDRAWN
}

enum DataRequestType {
  ACCESS
  CORRECTION
  UPDATE
  EXPORT
  ERASURE
}

enum DataRequestStatus {
  SUBMITTED
  UNDER_REVIEW
  ACTION_REQUIRED
  APPROVED
  REJECTED
  COMPLETED
  CANCELLED
}

enum DpaStatus {
  NOT_REQUIRED
  PENDING
  SIGNED
}

enum PrivacyRecordStatus {
  ACTIVE
  INACTIVE
}

enum PrivacyNoticeStatus {
  DRAFT
  PUBLISHED
}

enum BreachSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum BreachContainmentStatus {
  NOT_STARTED
  IN_PROGRESS
  CONTAINED
}

enum BreachNotificationStatus {
  NOT_ASSESSED
  NOT_REQUIRED
  PENDING
  NOTIFIED
}

enum BreachStatus {
  OPEN
  CLOSED
}

model PrivacySettings {
  id             String       @id @default(uuid())
  organizationId String       @unique
  organization   Organization @relation(fields: [organizationId], references: [id])

  privacyOfficerName  String @default("")
  privacyOfficerEmail String @default("")
  privacyOfficerPhone String @default("")
  grievanceInfo       String @default("")
  // Response window for data-principal requests; dueDate = createdAt + this.
  requestSlaDays      Int    @default(30)

  processingPurposes Json @default("[]")
  dataCategories     Json @default("[]")
  retentionRules     Json @default("[]")
  exportSettings     Json @default("{}")
  deletionRules      Json @default("{}")

  // Set once the built-in processor register entries were created, so an
  // admin deleting one never sees it silently come back.
  processorsSeededAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("privacy_settings")
}

model PrivacyNoticeVersion {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  version       Int
  title         String
  body          String
  status        PrivacyNoticeStatus @default(DRAFT)
  effectiveFrom DateTime?
  publishedById String?
  publishedAt   DateTime?
  createdById   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, version])
  @@index([organizationId, status])
  @@map("privacy_notice_versions")
}

// Append-only: a withdrawal is a new row, never an update of the grant.
model ConsentRecord {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  userId          String
  purposeKey      String
  status          ConsentStatus
  noticeVersionId String?
  source          String        @default("SELF_SERVICE")
  at              DateTime      @default(now())

  @@index([organizationId, userId, purposeKey, at])
  @@map("consent_records")
}

model DataRequest {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  seqNo     Int
  requestNo String
  userId    String
  type      DataRequestType
  status    DataRequestStatus @default(SUBMITTED)
  payload   Json              @default("{}")
  // Outcome details: applied/controlled fields, deletion restrictions, export info.
  result    Json              @default("{}")

  assignedToId  String?
  dueDate       DateTime
  completedAt   DateTime?
  resolution    String?
  events        Json      @default("[]")
  exportFileKey String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, seqNo])
  @@index([organizationId, userId])
  @@index([organizationId, status])
  @@map("data_requests")
}

model DataProcessor {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  name             String
  service          String
  dataProcessed    String              @default("")
  purpose          String              @default("")
  dpaStatus        DpaStatus           @default(PENDING)
  status           PrivacyRecordStatus @default(ACTIVE)
  isSystemDetected Boolean             @default(false)
  notes            String              @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@map("data_processors")
}

model DataSharingRecord {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  recipient      String
  dataCategory   String
  purpose        String              @default("")
  integration    String              @default("")
  status         PrivacyRecordStatus @default(ACTIVE)
  isAutoRecorded Boolean             @default(false)
  sharedAt       DateTime            @default(now())
  recordedById   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId, sharedAt])
  @@map("data_sharing_records")
}

model BreachIncident {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  seqNo              Int
  incidentNo         String
  // Short headline for the register (what happened, in a few words).
  title              String                   @default("")
  detectedAt         DateTime
  reportedBy         String                   @default("")
  affectedSystem     String                   @default("")
  dataCategories     String[]                 @default([])
  affectedUsersCount Int                      @default(0)
  description        String                   @default("")
  severity           BreachSeverity           @default(MEDIUM)
  containmentStatus  BreachContainmentStatus  @default(NOT_STARTED)
  investigation      String                   @default("")
  actionsTaken       String                   @default("")
  notificationStatus BreachNotificationStatus @default(NOT_ASSESSED)
  // DPDP: the Data Protection Board gets a detailed report within 72 hours of detection, and the affected people are told
  // without delay. These record when each was done; the due time is detectedAt + 72 hours (worked out, not stored).
  boardReportedAt      DateTime?
  principalsNotifiedAt DateTime?
  // When the Admins were last reminded about the Board report (24 hours left, then overdue), so each reminder goes once.
  dueSoonRemindedAt    DateTime?
  overdueRemindedAt    DateTime?
  resolution         String                   @default("")
  status             BreachStatus             @default(OPEN)
  closedAt           DateTime?
  createdById        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, seqNo])
  @@index([organizationId, status])
  @@map("breach_incidents")
}

// Append-only and hash-chained per organization: hash = sha256(prevHash +
// canonical row). No update/delete route exists. meta never holds sensitive
// values, only action descriptors (e.g. field names, counts).
model PrivacyAuditLog {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  seq          Int      @default(autoincrement())
  actorId      String?
  actorRole    String   @default("")
  action       String
  category     String
  targetUserId String?
  entity       String?
  entityId     String?
  result       String   @default("SUCCESS")
  ip           String   @default("")
  userAgent    String   @default("")
  meta         Json     @default("{}")
  prevHash     String   @default("")
  hash         String
  createdAt    DateTime @default(now())

  @@index([organizationId, seq])
  @@index([organizationId, category, createdAt])
  @@index([organizationId, targetUserId])
  @@map("privacy_audit_logs")
}

enum ResignationStatus {
  PENDING
  APPROVED
  REJECTED
  WITHDRAWN
}

// Where an employee's request to withdraw an APPROVED resignation stands (null = none was made). REQUESTED waits for
// HR/Admin; APPROVED means the exit was cancelled and the resignation withdrawn; DECLINED leaves the resignation as is.
enum WithdrawalRequestStatus {
  REQUESTED
  APPROVED
  DECLINED
}

// An employee's own resignation request. Approving it initiates the existing OffboardingCase (linked via
// offboardingCaseId, a plain id, no FK). decidedById is a plain id like the privacy tables' user refs.
model Resignation {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  employeeId String
  employee   User   @relation("ResignationEmployee", fields: [employeeId], references: [id])

  // YYYY-MM-DD, same plain-string convention as Leave.startDate.
  submittedOn      String
  requestedLwd     String
  approvedLwd      String?
  noticePeriodDays Int?
  reason           String?

  status ResignationStatus @default(PENDING)

  decidedById  String?
  decidedAt    DateTime?
  decisionNote String?

  offboardingCaseId String?

  // The employee's request to withdraw this resignation once it was approved (only HR/Admin can cancel the exit).
  // Plain ids like decidedById. A declined request can be raised again, which resets these fields.
  withdrawalStatus       WithdrawalRequestStatus?
  withdrawalReason       String?
  withdrawalRequestedAt  DateTime?
  withdrawalDecidedById  String?
  withdrawalDecidedAt    DateTime?
  withdrawalDecisionNote String?

  // Set when HR or an Admin recorded the resignation on the employee's behalf (given by email or in person): the id
  // of whoever entered it. NULL = the employee submitted it themselves. A plain id, like decidedById.
  recordedById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId, employeeId])
  @@index([organizationId, status])
  @@index([organizationId, withdrawalStatus])
  @@map("resignations")
}

enum EmployeeMovementType {
  TRANSFER
  PROMOTION
  MANAGER_CHANGE
  DESIGNATION_CHANGE
}

// One row per department/designation/grade/reporting-manager change made through EmployeesService.update().
// The change is applied to the user immediately; effectiveDate is recorded for history only (no future-dated
// application). Prev/new ids are plain values with no FK so history survives deletions.
model EmployeeMovement {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  employeeId String
  employee   User   @relation("EmployeeMovementEmployee", fields: [employeeId], references: [id])

  type          EmployeeMovementType
  // YYYY-MM-DD
  effectiveDate String
  reason        String?

  previousDepartmentId       String?
  newDepartmentId            String?
  previousDesignation        String?
  newDesignation             String?
  previousGradeLevel         String?
  newGradeLevel              String?
  previousReportingManagerId String?
  newReportingManagerId      String?
  previousWorkLocationId     String?
  newWorkLocationId          String?

  changedById String
  createdAt   DateTime @default(now())

  @@index([organizationId, employeeId])
  @@map("employee_movements")
}

// --- Asset Inventory ---------------------------------------------------
//
// The org's master list of physical assets it owns, distinct from
// EmployeeAsset (which is one *allocation event* — who had what, when).
// The two are linked only by EmployeeAsset.assetId (nullable), so the
// pre-existing free-text allocation flow keeps working untouched, and
// assignment stays owned entirely by the Employees module.

enum AssetInventoryStatus {
  AVAILABLE
  ASSIGNED
  UNDER_MAINTENANCE
  LOST
  RETIRED
  DISPOSED
}

enum AssetCondition {
  NEW
  GOOD
  FAIR
  POOR
  DAMAGED
}

enum AssetDocType {
  INVOICE
  WARRANTY_CERTIFICATE
  AMC
  SERVICE_REPORT
  OTHER
}

enum AssetMaintenanceStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model Asset {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  // Human-readable inventory code (e.g. AST-0001) — auto-generated from the
  // org's current asset count when the caller leaves it blank.
  assetCode String
  assetName String

  // Real FK (unlike DESIGNATION/GRADE/EMPLOYEE_CATEGORY, which store the
  // OrgListItem's name as a plain string on the consuming row) — an asset's
  // category is a genuine reference, not a snapshot label. Nullable so an
  // asset survives its category being deleted.
  categoryId String?
  category   OrgListItem? @relation("AssetCategory", fields: [categoryId], references: [id])

  // Required by the service only when the chosen category is named "Other" —
  // same convention as the Assets tab's existing "Specify Asset *" relabel
  // on EmployeeFullProfile (assetType === 'Other').
  categorySpecify String?

  brand String?
  model String?

  assetTag     String?
  serialNumber String?

  purchasedFrom String?
  purchaseDate  DateTime?
  // Float, matching every other money field in this schema (Loan.principal,
  // LoanRepayment.amount, ...) rather than introducing a second convention.
  purchaseCost  Float?
  vendorContact String?
  invoiceNumber String?
  poNumber      String?

  location  String?
  condition AssetCondition       @default(GOOD)
  status    AssetInventoryStatus @default(AVAILABLE)

  usefulLifeMonths Int?
  remarks          String?

  warrantyProvider     String?
  warrantyNumber       String?
  warrantyStartDate    DateTime?
  warrantyEndDate      DateTime?
  warrantyPeriodMonths Int?
  supportContact       String?
  supportEmail         String?
  supportPhone         String?
  warrantyTerms        String?

  // Soft delete — same isActive convention used throughout this schema.
  isActive Boolean @default(true)

  createdById String
  createdBy   User   @relation("AssetCreatedBy", fields: [createdById], references: [id])

  maintenances AssetMaintenance[]
  documents    AssetDocument[]
  allocations  EmployeeAsset[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Per-org, not global — NULLs are exempt from Postgres unique indexes
  // (same as EmployeeAsset.assetTag), so these only
  // bite when the field is actually provided.
  @@unique([organizationId, assetCode])
  @@unique([organizationId, assetTag])
  @@unique([organizationId, serialNumber])
  @@index([organizationId, status])
  @@index([organizationId, categoryId])
  @@map("assets")
}

model AssetMaintenance {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  assetId String
  asset   Asset  @relation(fields: [assetId], references: [id])

  serviceDate     DateTime
  issue           String
  serviceProvider String?
  serviceCost     Float?

  serviceStatus         AssetMaintenanceStatus @default(SCHEDULED)
  serviceStartDate      DateTime?
  serviceCompletionDate DateTime?
  nextServiceDate       DateTime?

  warrantyClaim Boolean @default(false)
  remarks       String?

  documents AssetDocument[]

  createdById String
  createdBy   User   @relation("AssetMaintenanceCreatedBy", fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId, assetId])
  @@map("asset_maintenances")
}

model AssetDocument {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  assetId String
  asset   Asset  @relation(fields: [assetId], references: [id])

  // Set when the document belongs to a specific service visit (a service
  // report), so it can be shown on that maintenance record while still
  // counting as one of the asset's documents.
  maintenanceId String?
  maintenance   AssetMaintenance? @relation(fields: [maintenanceId], references: [id])

  docType  AssetDocType
  fileName String
  // A durable relativeKey from POST /files/upload/documents — never a
  // signed URL, same convention as EmployeeDocument.fileUrl.
  fileUrl  String

  uploadedById String
  uploadedBy   User   @relation("AssetDocumentUploadedBy", fields: [uploadedById], references: [id])

  createdAt DateTime @default(now())

  @@index([organizationId, assetId])
  @@map("asset_documents")
}

// Per-employee location rule for check-in/out (User.locationRequirement); DEFAULT follows the organization.
enum LocationRequirement {
  DEFAULT
  ENFORCED
  RECORD_ONLY
  NOT_NEEDED
}

// Per-employee override of the org-wide "Require selfie at check-in /
// check-out" setting (User.selfieRequirement).
enum SelfieRequirement {
  DEFAULT
  REQUIRED
  NOT_REQUIRED
}

// Company-wide (departmentId null) or per-department achievement % for a
// financial year — multiplies variable pay (Target x Company % x Individual
// payout %). While PayrollSettings.companyPerformanceEnabled is on, variable
// pay is held until a row exists. Department row wins over the company row.
model CompanyPerformance {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  financialYear String
  departmentId  String?
  department    Department? @relation(fields: [departmentId], references: [id])

  achievementPercent Float
  notes              String @default("")

  createdById String?
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Postgres treats NULLs as distinct, so the company-wide row's uniqueness
  // (departmentId null) is enforced in CompanyPerformanceService.
  @@unique([organizationId, financialYear, departmentId])
  @@index([organizationId, financialYear])
  @@map("company_performance")
}

// TDS (salary) challan the employer deposited with the government for one deduction month. HR records the BSR code
// and challan serial from the bank receipt; the quarterly return and Form 130 map deductions to these.
model TdsChallan {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  // The month the tax was DEDUCTED in (not the month it was deposited).
  month         Int
  year          Int
  financialYear String
  // TDS quarter within the financial year (Apr-Jun = 1 ... Jan-Mar = 4).
  quarter       Int

  bsrCode         String
  challanSerialNo String
  // YYYY-MM-DD
  depositDate     String
  tdsAmount       Float
  interest        Float  @default(0)
  fee             Float  @default(0)
  notes           String @default("")

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([organizationId, financialYear, quarter])
  @@index([organizationId, year, month])
  @@map("tds_challans")
}

// The acknowledgement (receipt) number of a filed quarterly salary TDS statement (Form 138; Form 24Q before
// 1-Apr-2026). Form 130 / Form 16 Part B quotes it per quarter.
model TdsStatement {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  financialYear String
  quarter       Int
  formType      String  @default("138")
  receiptNumber String
  // YYYY-MM-DD
  filedOn       String?

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([organizationId, financialYear, quarter])
  @@map("tds_statements")
}

// A phone that receives push notifications for one user (Expo push token). One token = one app install; it is
// re-assigned (never duplicated) when a different account signs in on the same phone, and removed on sign-out or
// when Expo reports it is no longer valid.
model PushDevice {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  userId String
  user   User   @relation(fields: [userId], references: [id])

  token      String
  platform   String @default("")
  deviceName String @default("")

  // Reported by the app at login/device-register time; used for support and staged rollouts, not enforced.
  appVersion  String?
  buildNumber String?
  deviceType  String?
  deviceModel String?
  os          String?
  osVersion   String?

  lastSeenAt DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([token])
  @@index([organizationId, userId])
  @@map("push_devices")
}

// A report the Admin/HR asked to have emailed on a schedule (Reports > Scheduled). The period each run covers follows the
// frequency (yesterday / the last 7 days / last month), so nothing about dates is stored here.
model ScheduledReport {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  name         String
  // One of the keys in reports/scheduled-report-catalog.ts.
  reportKey    String
  // xlsx | csv | pdf
  format       String   @default("xlsx")
  // DAILY | WEEKLY | MONTHLY
  frequency    String
  // WEEKLY: 0 (Sunday) - 6. MONTHLY: 1 - 28. Unused for DAILY.
  dayOfWeek    Int?
  dayOfMonth   Int?
  // Hour of the day (0-23) in the organization's own timezone the email goes out.
  sendHour     Int      @default(8)
  recipients   String[]
  // Optional department filter for the reports that take one.
  departmentId String?
  enabled      Boolean  @default(true)

  // Whoever created it: the reports run with their access, and the schedule stops if they are no longer an active Admin/HR.
  createdById String

  // The organization's own calendar day of the last run - what keeps a run from going out twice in one day.
  lastRunDate   String?
  lastRunAt     DateTime?
  lastRunStatus String?
  lastRunError  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@map("scheduled_reports")
}

enum CustomFieldType {
  TEXT
  LONG_TEXT
  NUMBER
  DATE
  DROPDOWN
  CHECKBOX
}

// An extra field a company adds to every employee profile (Organization > Custom Fields) - blood group, vehicle number,
// T-shirt size - so the data does not need a code change per company. The values live on User.customFields keyed by
// `key`. A field is switched off (isActive false) rather than deleted, so values already entered are kept.
model CustomFieldDefinition {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  // Stable id of the field, made from the label when it is created and never changed (the values are stored under it).
  key              String
  label            String
  type             CustomFieldType
  // The choices of a DROPDOWN, as a list of strings.
  options          Json?
  required         Boolean         @default(false)
  helpText         String          @default("")
  // The heading it is shown under on the profile.
  section          String          @default("Additional information")
  // Whether the employee may fill in / change their own value (otherwise only HR and Admin).
  employeeEditable Boolean         @default(false)
  isActive         Boolean         @default(true)
  displayOrder     Int             @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, key])
  @@index([organizationId])
  @@map("custom_field_definitions")
}

// -- Control Center (platform) Super Admins ---------------------------------------------------------------------------
// Accounts for the vendor's Control Panel. They belong to no company (no organizationId), have their own login, token
// secret and session table, and can never be used on the HRMS itself - and an HRMS user can never be one of these.
enum SuperAdminRole {
  OWNER
  ADMIN
  SUPPORT
  BILLING
  READ_ONLY
}

enum SuperAdminStatus {
  ACTIVE
  INVITED
  DEACTIVATED
}

model SuperAdmin {
  id           String           @id @default(uuid())
  // Stored lower-case.
  email        String           @unique
  name         String
  // Null until an invited admin sets a password.
  passwordHash String?
  role         SuperAdminRole   @default(READ_ONLY)
  status       SuperAdminStatus @default(ACTIVE)
  // Two-factor sign-in is not built yet; the flag is carried so the panel's account screen has something to show.
  mfaEnabled   Boolean          @default(false)
  lastLoginAt  DateTime?

  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?

  // SHA-256 of the emailed reset token (never the token itself) and when it stops working.
  passwordResetTokenHash String?
  passwordResetExpires   DateTime?

  sessions SuperAdminSession[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("super_admins")
}

model SuperAdminSession {
  id           String     @id @default(uuid())
  superAdminId String
  superAdmin   SuperAdmin @relation(fields: [superAdminId], references: [id], onDelete: Cascade)

  // SHA-256 of the refresh token held in the browser's httpOnly cookie.
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  userAgent String?
  ip        String?
  createdAt DateTime  @default(now())

  @@index([superAdminId])
  @@map("super_admin_sessions")
}

// ---- Control Center: plans, subscriptions, billing, coupons, feature flags ----
// Status/type columns are plain strings (the values are validated in cc-*.service.ts) so a new status never needs a migration.
// Every table that belongs to a customer carries organizationId, which is how "delete organization" finds and removes it.

model CcPlan {
  id                   String           @id @default(uuid())
  name                 String
  code                 String           @unique
  billingModel         String           @default("PER_EMPLOYEE") // PER_EMPLOYEE | FIXED_TERM
  currency             String           @default("INR")
  trialDays            Int              @default(0)
  perEmployeeRate      Decimal?         @db.Decimal(12, 2)
  termMonths           Int?
  basePrice            Decimal?         @db.Decimal(12, 2)
  includedEmployees    Int?
  perExtraEmployeeRate Decimal?         @db.Decimal(12, 2)
  seatLimit            Int?
  gstApplicable        Boolean          @default(true)
  whiteLabelEligible   Boolean          @default(false)
  features             Json             @default("[]")
  limits               Json             @default("{}")
  isPublic             Boolean          @default(true)
  status               String           @default("ACTIVE") // ACTIVE | DEPRECATED | DRAFT
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
  subscriptions        CcSubscription[]

  @@map("cc_plans")
}

model CcSubscription {
  id                    String       @id @default(uuid())
  organizationId        String
  organization          Organization @relation(fields: [organizationId], references: [id])
  planId                String
  plan                  CcPlan       @relation(fields: [planId], references: [id])
  term                  String       @default("MONTHLY") // MONTHLY | YEARLY | FIVE_YEAR | TEN_YEAR
  termMonths            Int          @default(1)
  includedEmployeesSnap Int?
  // Negotiated per-employee monthly rate (Enterprise, or any special deal). Null = use the plan's own rate.
  customPerEmployeeRate Decimal?     @db.Decimal(12, 2)
  // Hard limit: HRMS refuses to add or reactivate an employee once this many are active. Null = no limit (billing still
  // charges for extra employees at the plan's extra rate, and the panel raises an over-limit alert).
  maxEmployees          Int?
  status                String       @default("TRIALING") // TRIALING | ACTIVE | PAST_DUE | CANCELED | EXPIRED
  trialEndsAt           DateTime?
  currentPeriodEnd      DateTime?
  cancelAtPeriodEnd     Boolean      @default(false)
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt

  @@index([organizationId])
  @@map("cc_subscriptions")
}

model CcInvoice {
  id             String       @id @default(uuid())
  number         String       @unique
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  status         String       @default("OPEN") // DRAFT | OPEN | PAID | VOID | UNCOLLECTIBLE
  subtotal       Decimal      @db.Decimal(12, 2)
  discount       Decimal      @default(0) @db.Decimal(12, 2)
  tax            Decimal      @default(0) @db.Decimal(12, 2)
  total          Decimal      @db.Decimal(12, 2)
  currency       String       @default("INR")
  dueDate        DateTime?
  lineItems      Json         @default("[]")
  couponCode     String?
  paidAt         DateTime?
  paymentRef     String?
  // The subscription period this invoice pays for, so paying it can extend the subscription.
  subscriptionId String?
  periodMonths   Int?
  source         String       @default("MANUAL") // MANUAL | GENERATED | AUTO
  lastReminderAt DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  payments       CcPayment[]

  @@index([organizationId])
  @@map("cc_invoices")
}

model CcPayment {
  id             String       @id @default(uuid())
  invoiceId      String
  invoice        CcInvoice    @relation(fields: [invoiceId], references: [id])
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  amount         Decimal      @db.Decimal(12, 2)
  currency       String       @default("INR")
  provider       String
  providerRef    String
  last4          String?
  status         String       @default("SUCCEEDED") // PENDING | SUCCEEDED | FAILED | REFUNDED | PARTIALLY_REFUNDED
  refundedAmount Decimal      @default(0) @db.Decimal(12, 2)
  createdAt      DateTime     @default(now())

  @@index([organizationId])
  @@map("cc_payments")
}

model CcCoupon {
  id               String    @id @default(uuid())
  code             String    @unique
  type             String // PERCENT | FIXED
  value            Decimal   @db.Decimal(12, 2)
  currency         String?
  maxRedemptions   Int?
  redeemedCount    Int       @default(0)
  perOrgLimit      Int?
  validFrom        DateTime?
  validUntil       DateTime?
  appliesToPlanIds Json      @default("[]")
  status           String    @default("ACTIVE") // ACTIVE | INACTIVE | EXPIRED
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@map("cc_coupons")
}

model CcFeatureFlag {
  key          String           @id
  description  String           @default("")
  defaultValue Json             @default("false")
  status       String           @default("ACTIVE") // ACTIVE | INACTIVE
  updatedAt    DateTime         @updatedAt
  overrides    CcFlagOverride[]

  @@map("cc_feature_flags")
}

model CcFlagOverride {
  id             String        @id @default(uuid())
  flagKey        String
  flag           CcFeatureFlag @relation(fields: [flagKey], references: [key], onDelete: Cascade)
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id])
  value          Json
  updatedAt      DateTime      @updatedAt

  @@unique([flagKey, organizationId])
  @@index([organizationId])
  @@map("cc_flag_overrides")
}

// ---- Control Center: support tickets, announcements, audit trail, platform settings ----
model CcTicket {
  id             String            @id @default(uuid())
  organizationId String?
  organization   Organization?     @relation(fields: [organizationId], references: [id])
  subject        String
  body           String
  status         String            @default("OPEN") // OPEN | PENDING | RESOLVED | CLOSED
  priority       String            @default("NORMAL") // LOW | NORMAL | HIGH | URGENT
  assigneeId     String? // a super_admins.id
  createdById    String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  comments       CcTicketComment[]

  @@index([organizationId])
  @@map("cc_tickets")
}

model CcTicketComment {
  id             String   @id @default(uuid())
  ticketId       String
  ticket         CcTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  // Copied from the ticket so deleting an organization also clears its ticket comments.
  organizationId String?
  authorId       String
  authorName     String
  body           String
  internal       Boolean  @default(false)
  createdAt      DateTime @default(now())

  @@index([ticketId])
  @@map("cc_ticket_comments")
}

model CcAnnouncement {
  id          String    @id @default(uuid())
  title       String
  body        String
  audience    String    @default("ALL") // ALL | PLAN | ORG
  audienceRef String? // plan id or organization id
  startsAt    DateTime?
  endsAt      DateTime?
  severity    String    @default("INFO") // INFO | WARNING | CRITICAL
  published   Boolean   @default(false) // status (DRAFT/SCHEDULED/LIVE/ENDED) is derived from this and the dates
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("cc_announcements")
}

// Append-only record of what Super Admins did in the panel. Not tied to an organization on purpose: it must survive
// deleting one.
model CcAuditLog {
  id         String   @id @default(uuid())
  at         DateTime @default(now())
  actorId    String
  actorEmail String
  ip         String   @default("")
  userAgent  String   @default("")
  action     String
  entityType String   @default("")
  entityId   String   @default("")
  before     Json?
  after      Json?
  context    Json?
  requestId  String   @default("")

  @@index([at])
  @@index([actorId])
  @@map("cc_audit_log")
}

model CcSetting {
  key         String   @id
  value       Json
  type        String   @default("string") // string | number | bool | json
  restricted  Boolean  @default(false) // restricted settings are shown read-only in the panel
  description String   @default("")
  updatedAt   DateTime @updatedAt

  @@map("cc_settings")
}

// ---- Control Center: account notes and alerts ----
// What the platform team knows about a customer (not the customer's own data): who looks after them, how to reach them, notes.
model CcOrgProfile {
  organizationId String       @id
  organization   Organization @relation(fields: [organizationId], references: [id])
  accountManager String?
  contactName    String?
  contactPhone   String?
  tags           Json         @default("[]")
  notes          String       @default("")
  churnReason    String?
  updatedAt      DateTime     @updatedAt

  @@map("cc_org_profiles")
}

// Things a Super Admin should know (new sign-up, overdue invoice, pilot ended, over the plan's employee limit).
// dedupeKey makes each event raise one alert, however often the daily job looks.
model CcAlert {
  id             String        @id @default(uuid())
  kind           String // SIGNUP | OVERDUE | PILOT_ENDED | OVER_LIMIT | TICKET | AUTO_SUSPENDED
  title          String
  body           String        @default("")
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])
  dedupeKey      String        @unique
  readAt         DateTime?
  createdAt      DateTime      @default(now())

  @@index([createdAt])
  @@map("cc_alerts")
}
