generator client {
  provider = "prisma-client-js"
}

// Connection URL lives in prisma.config.ts (Prisma 7 moved it out of the
// schema file) — used by the CLI for migrate/generate. The runtime
// PrismaClient is configured separately via a driver adapter, see
// src/prisma/prisma.service.ts.
datasource db {
  provider = "postgresql"
}

// A Postgres enum (not a lookup table) — mirrors the old MySQL backend's
// DB-level ENUM role column. Gives compile-time exhaustiveness in TS and
// makes adding SUPER_ADMIN later a one-line addition + one migration,
// rather than a new join table. A lookup table would only be justified for
// arbitrary per-tenant custom roles, which isn't a requirement here.
enum Role {
  ADMIN
  HR
  MANAGER
  EMPLOYEE
  // Future: SUPER_ADMIN. See RolesGuard for exactly how it plugs in.
}

// Mirrors the old MySQL backend's employmentStatus ENUM on User exactly
// (see employeeController.js ground truth) so the lifecycle vocabulary
// carries over unchanged even though the storage model doesn't.
// Nine stages: ON_HOLD (pre-joining only), ONBOARDING, PROBATION, EXTENDED_PROBATION, CONFIRMED, RESIGNED (resignation
// accepted, serving notice - still active and able to sign in), RELEASED (notice served, cleared, left), TERMINATED,
// ABSCONDED. RELEASED / TERMINATED / ABSCONDED are final.
// NOTICE_PERIOD is retired: the notice stage is RESIGNED now. The value stays in the enum only so the type does not
// have to be rebuilt; migration 20261115100000 moved every row off it and nothing sets it.
enum EmploymentStatus {
  ONBOARDING
  PROBATION
  EXTENDED_PROBATION
  CONFIRMED
  NOTICE_PERIOD
  RESIGNED
  RELEASED
  TERMINATED
  ABSCONDED
  ON_HOLD
}

enum Gender {
  MALE
  FEMALE
  OTHER
  PREFER_NOT_TO_SAY
}

enum ProbationStatus {
  PENDING
  CONFIRMED
  EXTENDED
}

model Organization {
  // Control Center billing (plans, subscriptions, invoices, payments, flag overrides) owned by this organization.
  ccSubscriptions CcSubscription[]
  ccInvoices      CcInvoice[]
  ccPayments      CcPayment[]
  ccFlagOverrides CcFlagOverride[]
  ccTickets       CcTicket[]
  ccOrgProfile    CcOrgProfile?
  ccAlerts        CcAlert[]

  id             String   @id @default(uuid())
  name           String
  timezone       String   @default("Asia/Kolkata")
  isActive       Boolean  @default(true)
  // The platform (Control Center) status: ACTIVE | PENDING | SUSPENDED | ARCHIVED. isActive is what the app enforces and
  // is false for SUSPENDED and ARCHIVED - nobody in the organisation can sign in or use a session while it is.
  platformStatus String   @default("ACTIVE")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // DEPRECATED — no longer read or written by anything. EmployeeIdService
  // now issues employee IDs through documentNumbering.employeeId (see
  // issueDocumentNumber in document-numbering.ts) instead of this
  // separate, disconnected counter, which silently ignored whatever
  // format an admin configured in the Setup Wizard's Document Numbering
  // step. Left in place rather than dropped in a migration — genuinely
  // dead now, but removing a column is a destructive change with no
  // functional upside over just not touching it.
  employeeIdPrefix  String @default("EMP")
  employeeIdCounter Int    @default(0)

  // Per-org secret for the Face API attendance-punch webhook
  // (POST /attendance/punch/ingest, @Public()). Previously a single
  // process-wide FACE_API_KEY env var authenticated every organization's
  // webhook, which let anyone holding that one shared key forge punches
  // for ANY org by setting an arbitrary organizationId in the payload —
  // a device secret is inherently more exposed than a user credential, so
  // that was a real cross-tenant write vector. Null until an admin
  // generates one (POST /organizations/settings/face-api-key/regenerate);
  // the webhook is fail-closed for orgs that haven't set one.
  faceApiKeyHash String? @unique

  // Admin toggle for whether WFH is offered as a work-arrangement option on
  // Attendance — the column on Attendance always accepts WFH regardless, so
  // disabling this later doesn't orphan history.
  enableWFH                           Boolean @default(true)
  // Same "auto-approve after N hours with no reviewer action" idea
  // LeaveType.autoApproveIfNoAction/autoApproveHours already gives HR per
  // leave type — WFH and Regularization requests have no "type" of their
  // own, so this lives org-wide instead. Off by default: nothing changes
  // for an org until HR/Admin explicitly turns it on and sets the window.
  wfhAutoApproveIfNoAction            Boolean @default(false)
  wfhAutoApproveHours                 Int     @default(24)
  regularizationAutoApproveIfNoAction Boolean @default(false)
  regularizationAutoApproveHours      Int     @default(24)
  // How many days back an employee may ask to regularize a day (1-31). Was a fixed 7.
  regularizationWindowDays            Int     @default(7)
  // Caps an Admin/HR can set on regularization requests; null (blank) = no limit, the default. Per employee, per month of
  // the date being regularized: every request submitted counts except a withdrawn one. And per date: how many times a
  // rejected request may be sent again.
  regularizationMonthlyLimit          Int?
  regularizationResubmitLimit         Int?
  // The month the leave year starts (1 = January = the calendar year, the default). Changing it from January is a
  // one-off transition that EXTENDS the calendar year in progress; leaveYearAnchorYear is the first year that starts
  // in that month. See leave-balances/leave-year.ts.
  leaveYearStartMonth                 Int     @default(1)
  leaveYearAnchorYear                 Int?
  // Org-wide fallback shift config, used by AttendanceService whenever an
  // employee's Department has none set (or there's no department at all).
  // A department's own shift-config fields always win over these. NOT the
  // same thing as orgPayrollAttendancePrefs below (Setup Wizard step 8) —
  // that's a much broader admin-facing preferences blob; this one is the
  // narrow AttendanceService consumer built in the Attendance batch. Kept
  // separate deliberately so extending the wizard's JSON shape can never
  // break the attendance-calculation consumer of this field.
  attendancePayrollPrefs              Json    @default("{\"defaultShiftStartTime\":\"09:30\",\"defaultShiftEndTime\":\"18:30\",\"defaultLateInThresholdMinutes\":15,\"defaultEarlyOutThresholdMinutes\":15,\"defaultMinHoursForPresent\":8,\"defaultMinHoursForHalfDay\":4,\"weekendDays\":[0,6]}")

  // --- Setup Wizard / Organization Settings — ported from the old
  // system's Organization model verbatim (field-for-field), which is the
  // single source of truth every other tenant-owned row hangs off of.
  // isInitialized gates app access for non-admin roles until an admin
  // finishes the 9-step wizard (enforced client-side, same as before).
  isInitialized   Boolean   @default(false)
  initializedAt   DateTime?
  initializedById String?
  initializedBy   User?     @relation("OrganizationInitializedBy", fields: [initializedById], references: [id])
  setupStep       Int       @default(1)

  // Step 1 — Company Profile
  companyName String?
  legalName   String?
  tagline     String?
  description String?

  // Step 2 — Registration Details
  gstin                  String?
  pan                    String?
  tan                    String?
  cin                    String?
  registrationNumber     String?
  lin                    String?
  msmeRegistrationNumber String?
  epfoEstablishmentCode  String?
  esicEmployerCode       String?
  ptRegistrationNumber   String?
  labourLicenseNumber    String?

  // Step 3 — Contact Information
  registeredAddress String?
  corporateAddress  String?
  city              String?
  state             String?
  country           String  @default("India")
  pincode           String?
  phone             String?
  mobile            String?
  contactEmail      String?
  website           String?

  // Custom "From" sending address, verified by the org proving domain
  // ownership via a DNS TXT record (no third-party API). Once
  // emailDomainStatus is "verified", EmailService sends from
  // emailSendingAddress instead of the shared platform EMAIL_FROM
  // address. See email-domain.service.ts / email.service.ts.
  emailSendingAddress          String?
  emailDomainVerificationToken String?
  // not_started | pending | verified | failed
  emailDomainStatus            String  @default("not_started")

  // Step 4 — Branding (companyLogoUrl doubles as the Step 1 company logo)
  companyLogoUrl  String?
  faviconUrl      String?
  reportLogoUrl   String?
  emailLogoUrl    String?
  primaryColor    String  @default("#5546e0")
  secondaryColor  String  @default("#14161d")
  // Large, faded, centered copy of the org's logo behind every page of a
  // generated document — Letters & Certificates (companyLogoUrl),
  // Payslips (each PayrollTemplate's own companyLogoUrl — see
  // payslip-pdf.service.ts, which deliberately never falls back to
  // Organization for branding fields; this toggle is a behavior switch,
  // not a branding value, so it's the one exception), and Report exports
  // (reportLogoUrl). See common/pdf-watermark.ts for the actual drawing.
  watermarkLogo   Boolean @default(false)
  // Optional full-width header and footer strips for generated Letters & Certificates (A4 width). When a header is set
  // it replaces the built-in logo / name / address block at the top of every page; the footer is drawn at the bottom
  // of every page. Both null = the built-in header, no footer strip. See letters/letter-pdf.service.ts.
  letterHeaderUrl String?
  letterFooterUrl String?
  // Original filename/size per uploaded image, keyed by upload field name
  // (logo/favicon/reportLogo/emailLogo/signature/seal) — the URL columns
  // point at a generated relativeKey, so this is the only place the real
  // uploaded filename survives, for display in Organization Settings.
  assetMeta       Json    @default("{}")

  // Superseded by emailSignatures below (named, multiple) — not every org
  // has one team sending all mail (HR vs Payroll vs IT, say), so a single
  // shared block wasn't enough. Column kept (unused) rather than dropped to
  // avoid a destructive migration; no code reads it anymore.
  emailSignatureHtml String @default("")
  // Named signatures an EmailTemplate can pick from (EmailTemplate.
  // signatureId — null means "use whichever one has isDefault:true").
  // [{ id, name, html, isDefault }]. Edited from the Email Templates
  // screen; appended below the rendered body when a template's email is
  // actually sent (see EmailTemplatesService.appendSignature).
  emailSignatures    Json   @default("[]")

  // Step 5 — Authorized Signatories: [{ id, name, designation,
  // signatureUrl, signatureMeta: {name,size}, isPrimary }]. Exactly one
  // entry is expected isPrimary:true; readers needing "the" signatory fall
  // back to the first entry. The seal is a single shared asset, its own
  // column, not per-signatory.
  signatories Json    @default("[]")
  sealUrl     String?

  // Step 7 — General Settings
  policies Json @default("{\"financialYearStartMonth\":4,\"timezone\":\"Asia/Kolkata\",\"currency\":\"INR\",\"currencySymbol\":\"₹\",\"dateFormat\":\"DD-MM-YYYY\",\"timeFormat\":\"24\",\"defaultNoticeDays\":30,\"language\":\"English\"}")

  // Step 8 — Payroll & Attendance Preferences (admin-facing, much broader
  // than attendancePayrollPrefs above — see that field's comment).
  orgPayrollAttendancePrefs Json @default("{\"defaultShiftStartTime\":\"09:30\",\"defaultShiftEndTime\":\"18:30\",\"defaultLateInThresholdMinutes\":15,\"defaultEarlyOutThresholdMinutes\":15,\"defaultMinHoursForPresent\":8,\"defaultMinHoursForHalfDay\":4,\"defaultWorkWeek\":\"monday-friday\",\"weekendDays\":[0,6],\"defaultWorkingHoursPerDay\":8}")

  // Step 9 — Document Numbering: { [type]: { label, format, resetRule,
  // counter, lastPeriodKey } }. employeeId here is descriptive only — the
  // row-locked employeeIdPrefix/employeeIdCounter columns above remain the
  // actual generator, not this JSON blob, so the two never drift.
  documentNumbering Json @default("{\"employeeId\":{\"label\":\"Employee ID\",\"format\":\"DP-{00000}\",\"resetRule\":\"never\",\"counter\":0,\"lastPeriodKey\":null},\"payslip\":{\"label\":\"Payslip\",\"format\":\"PS-{DD_MM_YYYY}-{00001}\",\"resetRule\":\"monthly\",\"counter\":0,\"lastPeriodKey\":null},\"offerLetter\":{\"label\":\"Offer Letter\",\"format\":\"OL-{DD_MM_YYYY}-{00001}\",\"resetRule\":\"yearly\",\"counter\":0,\"lastPeriodKey\":null},\"appointmentLetter\":{\"label\":\"Appointment Letter\",\"format\":\"AL-{DD_MM_YYYY}-{00001}\",\"resetRule\":\"yearly\",\"counter\":0,\"lastPeriodKey\":null},\"experienceLetter\":{\"label\":\"Experience Letter\",\"format\":\"EL-{DD_MM_YYYY}-{00001}\",\"resetRule\":\"yearly\",\"counter\":0,\"lastPeriodKey\":null},\"relievingLetter\":{\"label\":\"Relieving Letter\",\"format\":\"RL-{DD_MM_YYYY}-{00001}\",\"resetRule\":\"yearly\",\"counter\":0,\"lastPeriodKey\":null},\"salaryCertificate\":{\"label\":\"Salary Certificate\",\"format\":\"SC-{DD_MM_YYYY}-{00001}\",\"resetRule\":\"yearly\",\"counter\":0,\"lastPeriodKey\":null},\"fullFinalSettlement\":{\"label\":\"Full & Final Settlement\",\"format\":\"FNF-{DD_MM_YYYY}-{00001}\",\"resetRule\":\"yearly\",\"counter\":0,\"lastPeriodKey\":null},\"experienceCertificate\":{\"label\":\"Experience Certificate\",\"format\":\"EC-{DD_MM_YYYY}-{00001}\",\"resetRule\":\"yearly\",\"counter\":0,\"lastPeriodKey\":null},\"confirmationLetter\":{\"label\":\"Confirmation Letter\",\"format\":\"CL-{DD_MM_YYYY}-{00001}\",\"resetRule\":\"yearly\",\"counter\":0,\"lastPeriodKey\":null},\"probationExtensionLetter\":{\"label\":\"Probation Extension Letter\",\"format\":\"PE-{DD_MM_YYYY}-{00001}\",\"resetRule\":\"yearly\",\"counter\":0,\"lastPeriodKey\":null},\"promotionLetter\":{\"label\":\"Promotion Letter\",\"format\":\"PRL-{DD_MM_YYYY}-{00001}\",\"resetRule\":\"yearly\",\"counter\":0,\"lastPeriodKey\":null},\"incrementLetter\":{\"label\":\"Increment Letter\",\"format\":\"INC-{DD_MM_YYYY}-{00001}\",\"resetRule\":\"yearly\",\"counter\":0,\"lastPeriodKey\":null},\"transferLetter\":{\"label\":\"Transfer Letter\",\"format\":\"TRL-{DD_MM_YYYY}-{00001}\",\"resetRule\":\"yearly\",\"counter\":0,\"lastPeriodKey\":null},\"resignationAcceptance\":{\"label\":\"Resignation Acceptance Letter\",\"format\":\"RA-{DD_MM_YYYY}-{00001}\",\"resetRule\":\"yearly\",\"counter\":0,\"lastPeriodKey\":null},\"terminationLetter\":{\"label\":\"Termination Letter\",\"format\":\"TML-{DD_MM_YYYY}-{00001}\",\"resetRule\":\"yearly\",\"counter\":0,\"lastPeriodKey\":null},\"warningLetter\":{\"label\":\"Warning Letter\",\"format\":\"WL-{DD_MM_YYYY}-{00001}\",\"resetRule\":\"yearly\",\"counter\":0,\"lastPeriodKey\":null},\"nda\":{\"label\":\"Non-Disclosure Agreement\",\"format\":\"NDA-{DD_MM_YYYY}-{00001}\",\"resetRule\":\"yearly\",\"counter\":0,\"lastPeriodKey\":null},\"nonCompeteAgreement\":{\"label\":\"Non-Compete Agreement\",\"format\":\"NCA-{DD_MM_YYYY}-{00001}\",\"resetRule\":\"yearly\",\"counter\":0,\"lastPeriodKey\":null},\"nonSolicitationAgreement\":{\"label\":\"Non-Solicitation Agreement\",\"format\":\"NSA-{DD_MM_YYYY}-{00001}\",\"resetRule\":\"yearly\",\"counter\":0,\"lastPeriodKey\":null},\"letterOfIntent\":{\"label\":\"Letter of Intent\",\"format\":\"LOI-{DD_MM_YYYY}-{00001}\",\"resetRule\":\"yearly\",\"counter\":0,\"lastPeriodKey\":null},\"backgroundVerificationConsent\":{\"label\":\"Background Verification Consent\",\"format\":\"BVC-{DD_MM_YYYY}-{00001}\",\"resetRule\":\"yearly\",\"counter\":0,\"lastPeriodKey\":null},\"showCauseNotice\":{\"label\":\"Show-Cause Notice\",\"format\":\"SCN-{DD_MM_YYYY}-{00001}\",\"resetRule\":\"yearly\",\"counter\":0,\"lastPeriodKey\":null},\"suspensionLetter\":{\"label\":\"Suspension Letter\",\"format\":\"SL-{DD_MM_YYYY}-{00001}\",\"resetRule\":\"yearly\",\"counter\":0,\"lastPeriodKey\":null},\"retirementLetter\":{\"label\":\"Retirement Letter\",\"format\":\"RTL-{DD_MM_YYYY}-{00001}\",\"resetRule\":\"yearly\",\"counter\":0,\"lastPeriodKey\":null},\"internshipCertificate\":{\"label\":\"Internship Certificate\",\"format\":\"IC-{DD_MM_YYYY}-{00001}\",\"resetRule\":\"yearly\",\"counter\":0,\"lastPeriodKey\":null},\"employmentVerificationLetter\":{\"label\":\"Employment Verification Letter\",\"format\":\"EVL-{DD_MM_YYYY}-{00001}\",\"resetRule\":\"yearly\",\"counter\":0,\"lastPeriodKey\":null}}")

  // Admin-added employee types beyond the built-in default list (see
  // default-employee-types.ts) — each entry { value, label }.
  customEmployeeTypes Json @default("[]")

  // Built-in employee type `value`s this org has deactivated — built-ins
  // are hardcoded (DEFAULT_EMPLOYEE_TYPES), not DB rows, so there's
  // nowhere else on a built-in entry to persist an Active/Inactive flag.
  // Label/value stay immutable and undeletable either way; this only
  // gates whether one shows as active in the Employment Types list.
  inactiveBuiltinEmployeeTypes String[] @default([])

  // Bare enforcement hook for a future plan/billing system — high default
  // so nothing breaks until real billing exists.
  maxEmployees Int @default(999999)

  users                            User[]
  departments                      Department[]
  refreshTokens                    RefreshToken[]
  holidays                         Holiday[]
  workLocations                    WorkLocation[]
  workSchedules                    WorkSchedule[]
  leaveTypes                       LeaveType[]
  leaveBalances                    LeaveBalance[]
  leaves                           Leave[]
  compOffs                         CompOff[]
  salaryComponents                 SalaryComponent[]
  payrollSettings                  PayrollSettings?
  employeeSalaryComponents         EmployeeSalaryComponent[]
  openingBalances                  EmployeeOpeningBalance[]
  payrollTemplates                 PayrollTemplate[]
  statutoryConfigVersions          StatutoryConfigVersion[]
  employeeTaxDeclarations          EmployeeTaxDeclaration[]
  taxSlabConfigs                   TaxSlabConfig[]
  punches                          Punch[]
  attendances                      Attendance[]
  attendanceImportBatches          AttendanceImportBatch[]
  overtimeRecords                  OvertimeRecord[]
  scheduledReports                 ScheduledReport[]
  customFieldDefinitions           CustomFieldDefinition[]
  performanceRatings               PerformanceRating[]
  companyPerformance               CompanyPerformance[]
  tdsChallans                      TdsChallan[]
  tdsStatements                    TdsStatement[]
  leaveEncashments                 LeaveEncashment[]
  leaveGrants                      LeaveGrant[]
  leaveGrantRequests               LeaveGrantRequest[]
  payrollRuns                      PayrollRun[]
  reimbursements                   Reimbursement[]
  attendanceRegularizationRequests AttendanceRegularizationRequest[]
  leaveAccrualEntries              LeaveAccrualEntry[]
  loans                            Loan[]
  loanRepayments                   LoanRepayment[]
  settlements                      Settlement[]
  offboardingCases                 OffboardingCase[]
  joiningChecklists                JoiningChecklist[]
  companyBrands                    CompanyBrand[]
  resignations                     Resignation[]
  employeeMovements                EmployeeMovement[]
  auditLogs                        AuditLog[]
  timelineEvents                   EmployeeTimeline[]
  approvalDelegations              ApprovalDelegation[]
  policyDocuments                  PolicyDocument[]
  policyDocumentAcknowledgments    PolicyDocumentAcknowledgment[]
  documentRequirements             DocumentRequirement[]
  notifications                    Notification[]
  pushDevices                      PushDevice[]
  employeeDocuments                EmployeeDocument[]
  employeeAssets                   EmployeeAsset[]
  employeeRoleHistory              EmployeeRoleHistory[]
  employmentStatusHistory          EmploymentStatusHistory[]
  emailTemplates                   EmailTemplate[]
  letterTemplates                  LetterTemplate[]
  letterOverrides                  LetterOverride[]
  employeeLetterAccess             EmployeeLetterAccess[]
  orgListItems                     OrgListItem[]
  assets                           Asset[]
  assetMaintenances                AssetMaintenance[]
  assetDocuments                   AssetDocument[]
  privacySettings                  PrivacySettings?
  privacyNoticeVersions            PrivacyNoticeVersion[]
  consentRecords                   ConsentRecord[]
  dataRequests                     DataRequest[]
  dataProcessors                   DataProcessor[]
  dataSharingRecords               DataSharingRecord[]
  breachIncidents                  BreachIncident[]
  privacyAuditLogs                 PrivacyAuditLog[]
  payrollRunRevisions              PayrollRunRevision[]

  @@map("organizations")
}

model Department {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  name        String
  // Uppercased in DepartmentsService.create() — Prisma has no model-level
  // hooks like Sequelize's beforeValidate, so this is an explicit service
  // call rather than a DB-level guarantee.
  code        String
  description String  @default("")
  isActive    Boolean @default(true)

  departmentHeadId String?
  departmentHead   User?   @relation("DepartmentHead", fields: [departmentHeadId], references: [id])

  // Assigned geo-fence for self-punch validation (AttendanceService) — one
  // per department, not per-employee. Null = no enforcement for this dept.
  workLocationId String?
  workLocation   WorkLocation? @relation(fields: [workLocationId], references: [id])

  // Named shift template this department was last assigned from Work
  // Schedules (Organization Structure > Work Configuration). Assigning one
  // copies its startTime/endTime/workingDays onto shiftStartTime/
  // shiftEndTime/weeklyOffs below (so AttendanceService needs no separate
  // read path) and keeps this FK purely for "which departments use this
  // schedule" traceability in the Work Schedules screen — editing the
  // department's shift fields directly afterward doesn't clear it.
  workScheduleId String?
  workSchedule   WorkSchedule? @relation(fields: [workScheduleId], references: [id])

  // Per-department shift/attendance policy, read by
  // AttendanceService.recalculateAttendanceForDay. Falls back to
  // Organization.attendancePayrollPrefs's default* fields when unset at
  // the org level too (see attendance-shift-config.ts).
  shiftStartTime           String  @default("09:30")
  shiftEndTime             String  @default("18:30")
  lateInThresholdMinutes   Int     @default(15)
  earlyOutThresholdMinutes Int     @default(15)
  minHoursForPresent       Float   @default(8)
  minHoursForHalfDay       Float   @default(4)
  // [0]=Sunday ... 6=Saturday.
  weeklyOffs               Json    @default("[0]")
  // A shift that starts on one calendar day and ends on the next (e.g.
  // 22:00-06:00) — false (the default) preserves today's exact behavior.
  // When true, AttendanceService attributes a punch made after midnight
  // but before shiftEndTime to the *previous* day's shift instance instead
  // of starting a new same-day record, and pairs a day's check-in with a
  // check-out on the following calendar day when computing that day's
  // status/duration. See attendance-shift-config.ts and
  // AttendanceService.recalculateAttendanceForDay.
  crossesMidnight          Boolean @default(false)

  companyPerformance CompanyPerformance[]
  // Defaults to 0 (not WorkSchedule's own 60) so existing departments'
  // attendance calculation is unaffected until a schedule is actually
  // assigned — see attendance-shift-config.ts's resolveShiftConfig and
  // AttendanceService.recalculateAttendanceForDay, which subtracts this
  // from punch-in-to-punch-out duration before comparing against
  // minHoursForPresent/minHoursForHalfDay.
  breakMinutes       Int                  @default(0)

  employees User[]    @relation("EmployeeDepartment")
  holidays  Holiday[]

  attendanceImportBatches AttendanceImportBatch[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, name])
  @@unique([organizationId, code])
  @@index([organizationId])
  @@map("departments")
}

model User {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  // Globally unique (not per-org) so login can resolve the tenant from the
  // email alone, same reasoning as the old system. Always stored lowercased
  // (DTOs normalize via @NormalizeEmail); migration
  // 20260924040000_normalize_user_email_case also adds a hand-written
  // expression index, users_email_lower_key UNIQUE (lower(email)), which
  // Prisma can't express here — keep it if a future diff proposes dropping it.
  email    String @unique
  password String
  name     String
  role     Role   @default(EMPLOYEE)

  // Forgot/reset-password — a SHA-256 hash of the raw token mailed to the
  // user (never store the raw token), unique so a hash lookup can find the
  // owning row directly. Both null once unset/consumed. 30-minute expiry
  // enforced in AuthService, not the DB.
  resetPasswordToken   String?   @unique
  resetPasswordExpires DateTime?

  isFounder                Boolean   @default(false)
  isActive                 Boolean   @default(true)
  mustChangePassword       Boolean   @default(true)
  emailVerified            Boolean   @default(true)
  // Hash of the e-mail verification token sent when an organisation self-registers (null once verified).
  emailVerificationToken   String?   @unique
  emailVerificationExpires DateTime?
  lastLoginAt              DateTime?
  // When the password was last changed or reset. An access token issued before it stops working immediately (see
  // JwtAccessStrategy), instead of staying valid until its own expiry.
  passwordChangedAt        DateTime?

  // Standing opt-out from bulk payroll runs (PayrollService.targetEmployees)
  // — for someone tracked in the HRMS (attendance/leave) but never actually
  // paid through it, e.g. an unpaid intern. Doesn't affect a run explicitly
  // targeting this employee by id (dto.employeeId) — that's still an
  // explicit, deliberate action. Separate from CalculatePayrollDto's
  // per-run excludeEmployeeIds, which is for a one-off skip instead.
  excludeFromPayroll Boolean @default(false)

  // Exempt from the Labour Welfare Fund. The Maharashtra Labour Welfare Fund Act does not treat as an "employee" anyone
  // employed mainly in a managerial capacity, or in a supervisory capacity on wages above Rs 3,500 a month (or doing
  // mainly managerial work), so no contribution is due for them. Only HR can judge that, so it is a per-employee
  // setting; payroll then skips both the employee and employer LWF amounts.
  lwfExempt Boolean @default(false)

  // EPS (pension) membership. Most members belong to EPS from the day they join the PF; a member who joined the PF
  // after 1-Sep-2014 on PF wages above the ceiling then in force was kept out of it. When the ceiling rose to ₹25,000
  // (17-Sep-2026) EPFO made such members of wages up to the new ceiling EPS members from that date, so the exclusion
  // has an end: epsExcludedUntil is the last day outside EPS (YYYY-MM-DD), and null with epsExcluded = never a member.
  // Payroll gives an excluded member no EPS share (the whole employer 12% goes to EPF) for those days.
  epsExcluded      Boolean @default(false)
  epsExcludedUntil String?

  // Per-account brute-force lockout. The @Throttle() on POST /auth/login is
  // per-IP only, so a distributed attempt against ONE account (credential
  // stuffing from a botnet) never trips it — each IP stays under its own
  // limit while the account takes unlimited guesses. Counter resets on a
  // successful login or a completed password reset; see AuthService.login.
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?

  // Employee fields — Employee IS the User row, same as the old system
  // (no separate Employee entity). Unique per-org (not globally, unlike
  // email) via the composite unique index below, matching the old system's
  // users_org_employee_id_unique index exactly.
  employeeId           String
  designation          String           @default("")
  // Free-text, same as designation — sourced from OrgListItem
  // (type=GRADE/EMPLOYEE_CATEGORY) in the Employee form's dropdown, but
  // stored as a plain string here (no FK) so renaming/removing a master
  // list entry never orphans an existing employee's value, matching how
  // designation already works.
