generator client {
  provider = "prisma-client-js"
}

// Connection URL lives in prisma.config.ts (Prisma 7 moved it out of the
// schema file) — used by the CLI for migrate/generate. The runtime
// PrismaClient is configured separately via a driver adapter, see
// src/prisma/prisma.service.ts.
datasource db {
  provider = "postgresql"
}

// A Postgres enum (not a lookup table) — mirrors the old MySQL backend's
// DB-level ENUM role column. Gives compile-time exhaustiveness in TS and
// makes adding SUPER_ADMIN later a one-line addition + one migration,
// rather than a new join table. A lookup table would only be justified for
// arbitrary per-tenant custom roles, which isn't a requirement here.
enum Role {
  ADMIN
  HR
  MANAGER
  EMPLOYEE
  // Future: SUPER_ADMIN. See RolesGuard for exactly how it plugs in.
}

// Mirrors the old MySQL backend's employmentStatus ENUM on User exactly
// (see employeeController.js ground truth) so the lifecycle vocabulary
// carries over unchanged even though the storage model doesn't.
enum EmploymentStatus {
  ONBOARDING
  PROBATION
  EXTENDED_PROBATION
  CONFIRMED
  NOTICE_PERIOD
  RESIGNED
  RELEASED
  TERMINATED
  ABSCONDED
  ON_HOLD
}

model Organization {
  id        String   @id @default(uuid())
  name      String
  timezone  String   @default("Asia/Kolkata")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Row-locked counter for employeeId generation (SELECT ... FOR UPDATE in
  // EmployeeIdService) — deliberately simpler than the old system's
  // generalized documentNumbering JSON (which covers many document types);
  // this phase only needs the one counter. See the Phase 2 plan for why a
  // per-document-type config system isn't ported yet.
  employeeIdPrefix  String @default("EMP")
  employeeIdCounter Int    @default(0)

  users         User[]
  departments   Department[]
  refreshTokens RefreshToken[]

  @@map("organizations")
}

model Department {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  name        String
  // Uppercased in DepartmentsService.create() — Prisma has no model-level
  // hooks like Sequelize's beforeValidate, so this is an explicit service
  // call rather than a DB-level guarantee.
  code        String
  description String  @default("")
  isActive    Boolean @default(true)

  departmentHeadId String?
  departmentHead    User?   @relation("DepartmentHead", fields: [departmentHeadId], references: [id])

  employees User[] @relation("EmployeeDepartment")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, name])
  @@unique([organizationId, code])
  @@index([organizationId])
  @@map("departments")
}

model User {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  // Globally unique (not per-org) so login can resolve the tenant from the
  // email alone, same reasoning as the old system.
  email    String @unique
  password String
  name     String
  role     Role   @default(EMPLOYEE)

  isFounder          Boolean   @default(false)
  isActive            Boolean   @default(true)
  mustChangePassword Boolean   @default(true)
  emailVerified      Boolean   @default(true)
  lastLoginAt        DateTime?

  // Employee fields — Employee IS the User row, same as the old system
  // (no separate Employee entity). Unique per-org (not globally, unlike
  // email) via the composite unique index below, matching the old system's
  // users_org_employee_id_unique index exactly.
  employeeId       String
  designation      String           @default("")
  contactNumber    String           @default("")
  joiningDate      DateTime         @default(now())
  employeeType     String           @default("permanent")
  employmentStatus EmploymentStatus @default(ONBOARDING)

  departmentId String?
  department   Department? @relation("EmployeeDepartment", fields: [departmentId], references: [id])

  reportingManagerId String?
  reportingManager   User?   @relation("ReportingManager", fields: [reportingManagerId], references: [id])
  subordinates       User[]  @relation("ReportingManager")

  managedDepartments Department[] @relation("DepartmentHead")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  refreshTokens RefreshToken[]

  @@unique([organizationId, employeeId])
  @@index([organizationId])
  @@index([departmentId])
  @@map("users")
}

model RefreshToken {
  id             String       @id @default(uuid())
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Stored directly (not just derivable via userId) so the tenant-scope
  // Prisma extension never needs a special case for this model.
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  // SHA-256 hash of the raw token — the raw value is only ever returned
  // once, at issuance, and is never persisted. Mirrors the old system's
  // pattern for password-reset/email-verification tokens.
  tokenHash String @unique

  expiresAt           DateTime
  revokedAt            DateTime?
  // Set on rotation (see AuthService.refresh) — kept for audit/reuse-detection.
  replacedByTokenHash String?

  createdAt   DateTime @default(now())
  createdByIp String?
  userAgent   String?

  @@index([userId])
  @@index([organizationId])
  @@map("refresh_tokens")
}
