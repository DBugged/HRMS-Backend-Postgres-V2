# --- App ---
NODE_ENV=development
PORT=4000

# --- Database ---
DATABASE_URL="postgresql://hrms_v2_user:hrms_v2_pass@localhost:5432/hrms_v2_dev?schema=public"

# --- JWT ---
# Separate secrets for access vs refresh so a leaked access-token secret
# alone can't be used to mint forged long-lived refresh tokens (and vice versa).
JWT_ACCESS_SECRET=replace_with_openssl_rand_hex_32
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace_with_a_different_openssl_rand_hex_32
JWT_REFRESH_EXPIRES_IN_DAYS=7

# --- Cookies ---
REFRESH_COOKIE_NAME=refresh_token
REFRESH_COOKIE_PATH=/auth
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# --- CORS ---
CORS_ORIGIN=http://localhost:5173

# --- Bcrypt ---
BCRYPT_SALT_ROUNDS=10

# --- File storage ---
# Signs the short-lived tokens uploaded-file URLs are served through
# (GET /files/:token). Optional — falls back to JWT_ACCESS_SECRET if unset,
# but a separate secret means rotating one doesn't invalidate the other.
FILE_TOKEN_SECRET=replace_with_a_third_openssl_rand_hex_32

# Driver for uploaded files (documents, selfies, branding, profile
# photos): "local" (default, disk under backend-v2/uploads/ — what dev
# and the e2e suite always use) or "s3". Leave unset for local; set to
# "s3" only once AWS_REGION/AWS_S3_BUCKET below are real and this
# instance's IAM role or AWS credentials env vars
# (AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY) are in place — the SDK reads
# those the standard way, nothing custom here to configure.
FILE_STORAGE_DRIVER=local
AWS_REGION=us-east-1
AWS_S3_BUCKET=replace_with_your_bucket_name

# --- Rate limiting ---
# Requests/minute per IP allowed on login/register/forgot-password/
# reset-password. Defaults to 5 if unset. The e2e suite overrides this to
# a much higher number in .env.test since it logs in far more than 5x/min
# against a single instance as normal test behavior, not abuse.
AUTH_THROTTLE_LIMIT=5

# Requests/minute per IP allowed on report/export generation, bulk-import
# upload/execute, payslip PDF download, and payroll calculate/bulk-transition
# — all real per-request work (file rendering, bulk DB writes, running the
# formula engine over many employees), so they get a tighter cap than the
# global default (100/min, ThrottlerModule.forRoot in app.module.ts).
# Defaults to 20 if unset; the e2e suite overrides this in .env.test.
EXPENSIVE_OP_THROTTLE_LIMIT=20

# --- Email ---
# Sender shown on every outgoing email regardless of driver.
EMAIL_FROM=no-reply@dbuggedprogrammers.com

# Which provider actually sends mail: "smtp" (default) or "resend". Same
# opt-in pattern as FILE_STORAGE_DRIVER — leave unset for SMTP.
EMAIL_DRIVER=smtp

# Used when EMAIL_DRIVER=smtp (or unset). Left unconfigured, EmailService
# logs a dry-run to the console instead of sending — the content is never
# silently lost, only the delivery channel, so dev/test needs nothing here.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Used only when EMAIL_DRIVER=resend. Same dry-run-to-console fallback if
# left unset while the driver is switched to resend.
RESEND_API_KEY=

# --- Background jobs (Redis + BullMQ) ---
# Opt-in, same pattern as FILE_STORAGE_DRIVER=s3 above: unset by default,
# so dev/test never attempts a Redis connection at all. Set REDIS_URL to a
# real redis:// (or rediss://) URL to enable it — currently used for one
# job: rendering the payslip PDF and sending it by email after payroll
# pay() (PayrollService.afterPay -> PayslipEmailQueueService). Without
# this set, that work still happens, just synchronously on the request
# thread, exactly as before this was added.
REDIS_URL=

# --- Centralized log shipping ---
# Opt-in, same pattern as FILE_STORAGE_DRIVER=s3 above: unset by default, so
# every log line only goes to stdout (JSON in prod, pino-pretty locally),
# exactly as before this was added. Set LOG_SHIP_URL to an HTTP(S) endpoint
# that accepts a batch of newline-delimited JSON log lines
# (Content-Type: application/x-ndjson) — e.g. a Loki push gateway behind an
# adapter, Logtail/BetterStack, or your own collector — to also ship every
# log line there in the background. Shipping failures are swallowed (logs
# already reached stdout) and never affect request handling. Ignored during
# the e2e suite (NODE_ENV=test), which already runs pino at 'silent'.
LOG_SHIP_URL=

# --- Error tracking ---
# Opt-in, same pattern as FILE_STORAGE_DRIVER=s3 above: unset by default,
# so dev/test never sends anything anywhere. Set SENTRY_DSN to a real
# project DSN to enable — every unexpected (non-HttpException) 5xx caught
# by AllExceptionsFilter is then reported via Sentry.captureException().
# SENTRY_ENVIRONMENT tags events (e.g. "production", "staging"); falls
# back to NODE_ENV, then "development", if unset.
SENTRY_DSN=
SENTRY_ENVIRONMENT=
