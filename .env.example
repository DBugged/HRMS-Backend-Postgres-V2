# --- App ---
NODE_ENV=development
PORT=4000

# --- Database ---
DATABASE_URL="postgresql://hrms_v2_user:hrms_v2_pass@localhost:5432/hrms_v2_dev?schema=public"

# --- JWT ---
# Separate secrets for access vs refresh so a leaked access-token secret
# alone can't be used to mint forged long-lived refresh tokens (and vice versa).
JWT_ACCESS_SECRET=replace_with_openssl_rand_hex_32
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace_with_a_different_openssl_rand_hex_32
JWT_REFRESH_EXPIRES_IN_DAYS=7

# --- Cookies ---
REFRESH_COOKIE_NAME=refresh_token
REFRESH_COOKIE_PATH=/auth
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# --- CORS ---
CORS_ORIGIN=http://localhost:5173

# --- Bcrypt ---
BCRYPT_SALT_ROUNDS=10

# --- File storage ---
# Signs the short-lived tokens uploaded-file URLs are served through
# (GET /files/:token). Optional — falls back to JWT_ACCESS_SECRET if unset,
# but a separate secret means rotating one doesn't invalidate the other.
FILE_TOKEN_SECRET=replace_with_a_third_openssl_rand_hex_32

# Driver for uploaded files (documents, selfies, branding, profile
# photos): "local" (default, disk under backend-v2/uploads/ — what dev
# and the e2e suite always use) or "s3". Leave unset for local; set to
# "s3" only once AWS_REGION/AWS_S3_BUCKET below are real and this
# instance's IAM role or AWS credentials env vars
# (AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY) are in place — the SDK reads
# those the standard way, nothing custom here to configure.
FILE_STORAGE_DRIVER=local
AWS_REGION=us-east-1
AWS_S3_BUCKET=replace_with_your_bucket_name

# --- Rate limiting ---
# Requests/minute per IP allowed on login/register/forgot-password/
# reset-password. Defaults to 5 if unset. The e2e suite overrides this to
# a much higher number in .env.test since it logs in far more than 5x/min
# against a single instance as normal test behavior, not abuse.
AUTH_THROTTLE_LIMIT=5
